    <DTS:Executable DTS:refId="Package\EST_09_Validate_Staging" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL against NYCTaxi_Staging." DTS:DTSID="{E818D17B-5892-48F2-83BE-F38B7C6EF4B5}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="EST_09_Validate_Staging" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="1" DTS:DelayValidation="True">
      <DTS:Variables/>
      <DTS:ObjectData>
        <ns16:SqlTaskData xmlns:ns16="www.microsoft.com/sqlserver/dts/tasks/sqltask" ns16:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}" ns16:SqlStatementSource="SET NOCOUNT ON;&#10;DECLARE @StartMonth DATE = CONVERT(DATE, ? + '-01', 23),&#10;        @EndMonth DATE = CONVERT(DATE, ? + '-01', 23), @RowLimit INT = ?;&#10;IF @StartMonth &gt; @EndMonth OR @RowLimit &lt; 0 THROW 51010, 'Invalid extraction range.', 1;&#10;DECLARE @Month DATE = @StartMonth;&#10;DECLARE @Expected TABLE (DatasetCode VARCHAR(20), SourceKey NVARCHAR(260), RowLimit INT);&#10;WHILE @Month &lt;= @EndMonth&#10;BEGIN&#10;    INSERT @Expected (DatasetCode, SourceKey, RowLimit)&#10;    SELECT DatasetCode, DatasetCode + '_tripdata_' + CONVERT(CHAR(7), @Month, 126) + '.csv', @RowLimit&#10;    FROM (VALUES ('yellow'), ('green'), ('fhv'), ('fhvhv')) AS D(DatasetCode);&#10;    IF @Month = @EndMonth BREAK;&#10;    SET @Month = DATEADD(MONTH, 1, @Month);&#10;END;&#10;INSERT @Expected VALUES ('lookup', 'taxi_zone_lookup.csv', 0);&#10;IF EXISTS (&#10;    SELECT 1 FROM @Expected AS E LEFT JOIN etl.ExtractFileLog AS L&#10;        ON L.DatasetCode = E.DatasetCode AND L.SourceKey = E.SourceKey&#10;    WHERE L.SourceKey IS NULL OR L.LoadStatus &lt;&gt; 'SUCCEEDED'&#10;        OR L.RowLimit &lt;&gt; E.RowLimit OR L.RowsLoaded IS NULL OR L.RowsLoaded &lt;&gt; L.ExpectedRows)&#10;    THROW 51007, 'File load coverage is incomplete. Check etl.ExtractFileLog.', 1;&#10;" ns16:BypassPrepare="True" ns16:ResultType="ResultSetType_None">
          <ns16:ParameterBinding ns16:ParameterName="0" ns16:DtsVariableName="User::vStartMonth" ns16:ParameterDirection="Input" ns16:DataType="130" ns16:ParameterSize="7"/>
          <ns16:ParameterBinding ns16:ParameterName="1" ns16:DtsVariableName="User::vEndMonth" ns16:ParameterDirection="Input" ns16:DataType="130" ns16:ParameterSize="7"/>
          <ns16:ParameterBinding ns16:ParameterName="2" ns16:DtsVariableName="User::vMaxRows" ns16:ParameterDirection="Input" ns16:DataType="3" ns16:ParameterSize="-1"/>
        </ns16:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
