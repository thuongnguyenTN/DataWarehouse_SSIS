        <DTS:Executable DTS:refId="Package\FLC_04_Load_Yellow_Files\EST_Begin_Yellow_File" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL against NYCTaxi_Staging." DTS:DTSID="{15C01627-F6F1-4CDC-81A7-AC9E3C0B21C5}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="EST_Begin_Yellow_File" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="2" DTS:DelayValidation="True">
          <DTS:Variables/>
          <DTS:ObjectData>
