      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}"
          SQLTask:SqlStatementSource="DECLARE @r nvarchar(64)=?, @e nvarchar(4000)=?; INSERT etl.PackageError(ExecutionId,PackageName,SourceName,ErrorCode,ErrorDescription) VALUES(@r,N'PKG_00_Master',N'Master failure branch',55990,@e); DECLARE @m nvarchar(2047)=LEFT(CONCAT(N'Master failed. RunId=',@r,N'. ',COALESCE(NULLIF(@e,N''),N'See local ETL monitor/logs.')),2000); RAISERROR(N'%s',16,1,@m);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::vRunId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="64" />
          <SQLTask:ParameterBinding
