  <DTS:EventHandlers>
    <DTS:EventHandler
      DTS:refId="Package.EventHandlers[OnError]"
      DTS:CreationName="OnError"
      DTS:DTSID="{8FF57532-7867-4CEB-9BD0-C32C69E7BCF8}"
