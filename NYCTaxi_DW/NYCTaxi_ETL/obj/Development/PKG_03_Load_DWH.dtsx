            <component
              refId="Package\DFT_06_Load_DimFlags\SRC_HVFHVFlags"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_HVFHVFlags"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    F.IsSharedRequest,
    F.IsSharedMatch,
    F.IsAccessARide,
    F.IsWAVRequest,
    F.IsWAVMatch
FROM
(
    SELECT
        CASE
            WHEN UPPER(SharedRequestFlag) IN ('Y', 'N')
                THEN UPPER(SharedRequestFlag)
            ELSE 'U'
        END AS IsSharedRequest,

        CASE
            WHEN UPPER(SharedMatchFlag) IN ('Y', 'N')
                THEN UPPER(SharedMatchFlag)
            ELSE 'U'
        END AS IsSharedMatch,

        CASE
            WHEN UPPER(AccessARideFlag) IN ('Y', 'N')
                THEN UPPER(AccessARideFlag)
            ELSE 'U'
        END AS IsAccessARide,

        CASE
            WHEN UPPER(WAVRequestFlag) IN ('Y', 'N')
                THEN UPPER(WAVRequestFlag)
            ELSE 'U'
        END AS IsWAVRequest,

        CASE
            WHEN UPPER(WAVMatchFlag) IN ('Y', 'N')
                THEN UPPER(WAVMatchFlag)
            ELSE 'U'
        END AS IsWAVMatch
    FROM clean.ValidTrip
    WHERE TaxiType = 'FHVHV'
) AS F
WHERE NOT EXISTS
(
    SELECT 1
    FROM NYCTaxi_DWH.dbo.Dim_HVFHVFlags AS D
    WHERE D.IsSharedRequest = F.IsSharedRequest
      AND D.IsSharedMatch = F.IsSharedMatch
      AND D.IsAccessARide = F.IsAccessARide
      AND D.IsWAVRequest = F.IsWAVRequest
      AND D.IsWAVMatch = F.IsWAVMatch
);</property>
