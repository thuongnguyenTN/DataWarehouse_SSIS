    <DTS:Executable
      DTS:refId="Package\EST_01_Precheck_Clean"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{92549A44-22AF-42B4-BF2F-75427667A456}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_01_Precheck_Clean"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;-- Kiểm tra bảng Clean&#xA;IF OBJECT_ID('clean.Trip', 'U') IS NULL&#xA;    THROW 51001, 'Khong ton tai bang clean.Trip.', 1;&#xA;&#xA;IF OBJECT_ID('clean.TaxiZone', 'U') IS NULL&#xA;    THROW 51002, 'Khong ton tai bang clean.TaxiZone.', 1;&#xA;&#xA;-- Kiểm tra Taxi Zone&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.TaxiZone&#xA;)&#xA;    THROW 51003, 'clean.TaxiZone khong co du lieu.', 1;&#xA;&#xA;-- Kiểm tra Yellow&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.Trip&#xA;    WHERE TaxiType = 'YELLOW'&#xA;      AND IsCoreValid = 1&#xA;)&#xA;    THROW 51004, 'Khong co du lieu YELLOW hop le.', 1;&#xA;&#xA;-- Kiểm tra Green&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.Trip&#xA;    WHERE TaxiType = 'GREEN'&#xA;      AND IsCoreValid = 1&#xA;)&#xA;    THROW 51005, 'Khong co du lieu GREEN hop le.', 1;&#xA;&#xA;-- Kiểm tra FHV&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.Trip&#xA;    WHERE TaxiType = 'FHV'&#xA;      AND IsCoreValid = 1&#xA;)&#xA;    THROW 51006, 'Khong co du lieu FHV hop le.', 1;&#xA;&#xA;-- Kiểm tra FHVHV&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.Trip&#xA;    WHERE TaxiType = 'FHVHV'&#xA;      AND IsCoreValid = 1&#xA;)&#xA;    THROW 51007, 'Khong co du lieu FHVHV hop le.', 1;&#xA;&#xA;-- Kiểm tra database DWH&#xA;IF DB_ID('NYCTaxi_DWH') IS NULL&#xA;    THROW 51008, 'Khong ton tai database NYCTaxi_DWH.', 1;&#xA;&#xA;-- Kiểm tra các bảng Fact đích&#xA;IF OBJECT_ID(&#xA;    'NYCTaxi_DWH.dbo.Fact_YellowGreen_Trips',&#xA;    'U'&#xA;) IS NULL&#xA;    THROW 51009, 'Khong ton tai Fact_YellowGreen_Trips.', 1;&#xA;&#xA;IF OBJECT_ID(&#xA;    'NYCTaxi_DWH.dbo.Fact_FHV_Trips',&#xA;    'U'&#xA;) IS NULL&#xA;    THROW 51010, 'Khong ton tai Fact_FHV_Trips.', 1;&#xA;&#xA;IF OBJECT_ID(&#xA;    'NYCTaxi_DWH.dbo.Fact_HVFHV_Trips',&#xA;    'U'&#xA;) IS NULL&#xA;    THROW 51011, 'Khong ton tai Fact_HVFHV_Trips.', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_07_Clear_Facts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3ED69CA4-FBC9-4D27-B68E-85DADE589EC4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_07_Clear_Facts"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;TRUNCATE TABLE dbo.Fact_YellowGreen_Trips;&#xA;TRUNCATE TABLE dbo.Fact_FHV_Trips;&#xA;TRUNCATE TABLE dbo.Fact_HVFHV_Trips;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_11_Validate_DWH"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{27F92C3B-A398-4917-BCC8-CC2F70AE6062}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_11_Validate_DWH"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.Fact_YellowGreen_Trips&#xA;)&#xA;    THROW 52001, 'Fact YellowGreen khong co du lieu.', 1;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.Fact_FHV_Trips&#xA;)&#xA;    THROW 52002, 'Fact FHV khong co du lieu.', 1;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.Fact_HVFHV_Trips&#xA;)&#xA;    THROW 52003, 'Fact FHVHV khong co du lieu.', 1;&#xA;&#xA;DECLARE @SourceYellowGreen BIGINT =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM NYCTaxi_Staging.clean.ValidTrip&#xA;    WHERE TaxiType IN ('YELLOW', 'GREEN')&#xA;);&#xA;&#xA;DECLARE @SourceFHV BIGINT =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM NYCTaxi_Staging.clean.ValidTrip&#xA;    WHERE TaxiType = 'FHV'&#xA;);&#xA;&#xA;DECLARE @SourceFHVHV BIGINT =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM NYCTaxi_Staging.clean.ValidTrip&#xA;    WHERE TaxiType = 'FHVHV'&#xA;);&#xA;&#xA;IF @SourceYellowGreen &lt;&gt;&#xA;   (SELECT COUNT_BIG(*) FROM dbo.Fact_YellowGreen_Trips)&#xA;    THROW 52004, 'Sai so dong Fact YellowGreen.', 1;&#xA;&#xA;IF @SourceFHV &lt;&gt;&#xA;   (SELECT COUNT_BIG(*) FROM dbo.Fact_FHV_Trips)&#xA;    THROW 52005, 'Sai so dong Fact FHV.', 1;&#xA;&#xA;IF @SourceFHVHV &lt;&gt;&#xA;   (SELECT COUNT_BIG(*) FROM dbo.Fact_HVFHV_Trips)&#xA;    THROW 52006, 'Sai so dong Fact FHVHV.', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
