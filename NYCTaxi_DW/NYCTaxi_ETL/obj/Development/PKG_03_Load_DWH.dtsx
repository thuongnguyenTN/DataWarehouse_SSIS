            <component
              refId="Package\DFT_08_Load_FactYellowGreen\SRC_ValidYellowGreen"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_ValidYellowGreen"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    COALESCE(PickupDate.DateKey, 0) AS PickupDateKey,
    COALESCE(DropoffDate.DateKey, 0) AS DropoffDateKey,

    COALESCE(PickupTime.TimeKey, 0) AS PickupTimeKey,
    COALESCE(DropoffTime.TimeKey, 0) AS DropoffTimeKey,

    COALESCE(PickupZone.LocationKey, 0) AS PickupLocationKey,
    COALESCE(DropoffZone.LocationKey, 0) AS DropoffLocationKey,

    COALESCE(ServiceType.ServiceTypeKey, 0) AS ServiceTypeKey,
    COALESCE(Vendor.VendorKey, 0) AS VendorKey,
    COALESCE(RateCode.RateCodeKey, 0) AS RateCodeKey,
    COALESCE(Payment.PaymentTypeKey, 0) AS PaymentTypeKey,
    COALESCE(TripType.TripTypeKey, 0) AS TripTypeKey,
    COALESCE(TaxiFlag.TaxiFlagKey, 0) AS TaxiFlagKey,
    COALESCE(PassengerGroup.PassengerGroupKey, 0)
        AS PassengerGroupKey,

    0 AS LoadBatchKey,
    1 AS TripCount,

    C.PassengerCount,
    C.TripDistanceMiles,
    C.TripDurationSeconds,

    CASE
        WHEN C.TripDurationSeconds &gt; 0
             AND C.TripDistanceMiles &gt;= 0
        THEN CONVERT
        (
            DECIMAL(12,3),
            C.TripDistanceMiles * 3600.0
            / C.TripDurationSeconds
        )
        ELSE NULL
    END AS AverageSpeedMPH,

    C.FareAmount,
    C.ExtraAmount,
    C.MTATaxAmount,
    C.TipAmount,
    C.TollsAmount,
    C.ImprovementSurcharge,
    C.CongestionSurcharge,
    C.AirportFee,
    C.CBDCongestionFee,
    C.TotalAmount

FROM clean.ValidTrip AS C

LEFT JOIN NYCTaxi_DWH.dbo.Dim_Date AS PickupDate
    ON PickupDate.FullDate =
       CONVERT(DATE, C.PickupDateTime)

LEFT JOIN NYCTaxi_DWH.dbo.Dim_Date AS DropoffDate
    ON DropoffDate.FullDate =
       CONVERT(DATE, C.DropoffDateTime)

LEFT JOIN NYCTaxi_DWH.dbo.Dim_Time AS PickupTime
    ON PickupTime.MinuteOfDay =
       DATEPART(HOUR, C.PickupDateTime) * 60
       + DATEPART(MINUTE, C.PickupDateTime)

LEFT JOIN NYCTaxi_DWH.dbo.Dim_Time AS DropoffTime
    ON DropoffTime.MinuteOfDay =
       DATEPART(HOUR, C.DropoffDateTime) * 60
       + DATEPART(MINUTE, C.DropoffDateTime)

LEFT JOIN NYCTaxi_DWH.dbo.Dim_Location AS PickupZone
    ON PickupZone.LocationID = C.PULocationID

LEFT JOIN NYCTaxi_DWH.dbo.Dim_Location AS DropoffZone
    ON DropoffZone.LocationID = C.DOLocationID

LEFT JOIN NYCTaxi_DWH.dbo.Dim_ServiceType AS ServiceType
    ON ServiceType.ServiceCode = C.TaxiType

LEFT JOIN NYCTaxi_DWH.dbo.Dim_Vendor AS Vendor
    ON Vendor.VendorID = C.VendorID

LEFT JOIN NYCTaxi_DWH.dbo.Dim_RateCode AS RateCode
    ON RateCode.RateCodeID = C.RateCodeID

LEFT JOIN NYCTaxi_DWH.dbo.Dim_PaymentType AS Payment
    ON Payment.PaymentTypeID = C.PaymentTypeID

LEFT JOIN NYCTaxi_DWH.dbo.Dim_TripType AS TripType
    ON TripType.TripTypeID = C.TripTypeID

LEFT JOIN NYCTaxi_DWH.dbo.Dim_TaxiFlags AS TaxiFlag
    ON TaxiFlag.StoreAndFwd =
       CASE
           WHEN UPPER(C.StoreAndFwdFlag) IN ('Y', 'N')
               THEN UPPER(C.StoreAndFwdFlag)
           ELSE 'U'
       END

LEFT JOIN NYCTaxi_DWH.dbo.Dim_PassengerGroup AS PassengerGroup
    ON C.PassengerCount BETWEEN
       PassengerGroup.MinCount AND PassengerGroup.MaxCount

WHERE C.TaxiType IN ('YELLOW', 'GREEN');</property>
