  DTS:DTSID="{26DDE3C6-72C4-4EBF-ABA9-8773A0EA956B}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="17.0.1016.0"
  DTS:LocaleID="1033"
  DTS:ObjectName="PKG_03_Load_DWH"
  DTS:PackageType="5"
  DTS:VersionBuild="3"
  DTS:VersionGUID="{CC9AA213-5D12-4110-A65A-C2E5C6452833}">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\EST_00_Precheck_DWH"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="EST_00_Precheck_DWH - SQL Server transactional load"
      DTS:DTSID="{B8F83559-BB01-413D-A252-A797A03D0714}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_00_Precheck_DWH"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;IF DB_ID(N'NYCTaxi_Staging') IS NULL OR DB_ID(N'NYCTaxi_DWH') IS NULL&#xA;    THROW 55001, 'Missing database NYCTaxi_Staging or NYCTaxi_DWH.', 1;&#xA;IF OBJECT_ID(N'NYCTaxi_Staging.clean.ValidTrip',N'V') IS NULL&#xA;    THROW 55002, 'Missing NYCTaxi_Staging.clean.ValidTrip; run Transform first.', 1;&#xA;IF OBJECT_ID(N'NYCTaxi_Staging.clean.TaxiZone',N'U') IS NULL&#xA;    THROW 55003, 'Missing clean.TaxiZone.', 1;&#xA;IF OBJECT_ID(N'dbo.Fact_YellowGreen_Trips',N'U') IS NULL&#xA; OR OBJECT_ID(N'dbo.Fact_FHV_Trips',N'U') IS NULL&#xA; OR OBJECT_ID(N'dbo.Fact_HVFHV_Trips',N'U') IS NULL&#xA;    THROW 55004, 'Missing transactional Fact tables; run 04_create_nyctaxi_dwh.sql.', 1;&#xA;IF NOT EXISTS(SELECT 1 FROM dbo.Dim_Time WHERE MinuteOfDay=0 AND TimeKey=1)&#xA; OR NOT EXISTS(SELECT 1 FROM dbo.Dim_Time WHERE MinuteOfDay=1439 AND TimeKey=1440)&#xA;    THROW 55005, 'Dim_Time not initialized (TimeKey must be MinuteOfDay + 1).',1;&#xA;IF NOT EXISTS(SELECT 1 FROM NYCTaxi_Staging.clean.ValidTrip)&#xA;    THROW 55006, 'No valid trips in clean.ValidTrip.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'etl')&#xA;    EXEC(N'CREATE SCHEMA etl AUTHORIZATION dbo');&#xA;IF OBJECT_ID(N'etl.LoadStepLog',N'U') IS NULL&#xA;    CREATE TABLE etl.LoadStepLog&#xA;    (&#xA;        LogID BIGINT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;        StepName NVARCHAR(100) NOT NULL,&#xA;        InsertedRows BIGINT NULL,&#xA;        CompletedAt DATETIME2(0) NOT NULL DEFAULT SYSDATETIME()&#xA;    );&#xA;IF NOT EXISTS(SELECT 1 FROM sys.indexes WHERE object_id=OBJECT_ID(N'dbo.Fact_YellowGreen_Trips') AND name=N'UX_FYG_RecordHash')&#xA;    CREATE UNIQUE INDEX UX_FYG_RecordHash ON dbo.Fact_YellowGreen_Trips(RecordHash) WHERE RecordHash IS NOT NULL;&#xA;IF NOT EXISTS(SELECT 1 FROM sys.indexes WHERE object_id=OBJECT_ID(N'dbo.Fact_FHV_Trips') AND name=N'UX_FHV_RecordHash')&#xA;    CREATE UNIQUE INDEX UX_FHV_RecordHash ON dbo.Fact_FHV_Trips(RecordHash) WHERE RecordHash IS NOT NULL;&#xA;IF NOT EXISTS(SELECT 1 FROM sys.indexes WHERE object_id=OBJECT_ID(N'dbo.Fact_HVFHV_Trips') AND name=N'UX_HVFHV_RecordHash')&#xA;    CREATE UNIQUE INDEX UX_HVFHV_RecordHash ON dbo.Fact_HVFHV_Trips(RecordHash) WHERE RecordHash IS NOT NULL;&#xA;&#xA;IF OBJECT_ID('etl.FactChangeAudit','U') IS NULL CREATE TABLE etl.FactChangeAudit(&#xA; AuditId bigint IDENTITY PRIMARY KEY,TableName sysname NOT NULL,RowJson nvarchar(max) NOT NULL,&#xA; DeletedAt datetime2 NOT NULL DEFAULT SYSUTCDATETIME());&#xA;IF COL_LENGTH('dbo.Fact_YellowGreen_Trips','SourceDataset') IS NULL ALTER TABLE dbo.Fact_YellowGreen_Trips ADD SourceDataset varchar(20) NULL;&#xA;IF COL_LENGTH('dbo.Fact_YellowGreen_Trips','SourceKey') IS NULL ALTER TABLE dbo.Fact_YellowGreen_Trips ADD SourceKey nvarchar(260) NULL;&#xA;IF COL_LENGTH('dbo.Fact_FHV_Trips','SourceDataset') IS NULL ALTER TABLE dbo.Fact_FHV_Trips ADD SourceDataset varchar(20) NULL;&#xA;IF COL_LENGTH('dbo.Fact_FHV_Trips','SourceKey') IS NULL ALTER TABLE dbo.Fact_FHV_Trips ADD SourceKey nvarchar(260) NULL;&#xA;IF COL_LENGTH('dbo.Fact_HVFHV_Trips','SourceDataset') IS NULL ALTER TABLE dbo.Fact_HVFHV_Trips ADD SourceDataset varchar(20) NULL;&#xA;IF COL_LENGTH('dbo.Fact_HVFHV_Trips','SourceKey') IS NULL ALTER TABLE dbo.Fact_HVFHV_Trips ADD SourceKey nvarchar(260) NULL;&#xA;&#xA;-- FILE_V1_20261031&#xA;SET NOCOUNT ON;&#xA;IF OBJECT_ID('etl.DwhFileLog','U') IS NULL&#xA;CREATE TABLE etl.DwhFileLog(&#xA; DatasetCode varchar(20) NOT NULL, SourceKey nvarchar(260) NOT NULL,&#xA; SourceVersion char(64) NULL, LoaderVersion varchar(40) NULL,&#xA; Status varchar(20) NOT NULL, ForceReload bit NOT NULL DEFAULT 0,&#xA; ValidRows bigint NULL, FactRows bigint NULL, InsertedRows bigint NULL,&#xA; UpdatedRows bigint NULL, DeletedRows bigint NULL,&#xA; UnknownMask int NOT NULL DEFAULT 0,&#xA; LocationMapHash char(64) NULL, BaseMapHash char(64) NULL, OtherMapHash char(64) NULL,&#xA; CompletedAt datetime2 NULL, ErrorMessage nvarchar(max) NULL,&#xA; CONSTRAINT PK_DwhFileLog PRIMARY KEY(DatasetCode,SourceKey));&#xA;EXEC(N'CREATE OR ALTER VIEW etl.DwhSourceState AS&#xA; SELECT T.DatasetCode,T.SourceKey,T.FileHash,T.ValidRows,T.SourceRows,T.CompletedAt,&#xA; CONVERT(char(64),HASHBYTES(''SHA2_256'',CONCAT(T.FileHash,''|'',T.RuleVersion,''|'',T.ZoneHash,&#xA; ''|'',T.SourceRows,''|'',T.ValidRows,''|'',T.RejectedRows,''|'',CONVERT(varchar(33),T.CompletedAt,126))),2) AS SourceVersion&#xA; FROM NYCTaxi_Staging.etl.TransformFileLog T&#xA; JOIN NYCTaxi_Staging.etl.ExtractFileLog E ON E.DatasetCode=T.DatasetCode AND E.SourceKey=T.SourceKey&#xA; WHERE E.DatasetCode IN(''yellow'',''green'',''fhv'',''fhvhv'') AND E.LoadStatus=''SUCCEEDED'' AND E.RowsLoaded=E.ExpectedRows&#xA; AND E.FileHash=T.FileHash AND E.ExpectedRows=T.SourceRows AND T.CleanRows=T.SourceRows&#xA; AND T.ValidRows+T.RejectedRows=T.CleanRows;');&#xA;&#xA;IF NOT EXISTS(SELECT 1 FROM sys.indexes WHERE object_id=OBJECT_ID('dbo.Fact_YellowGreen_Trips') AND name='IX_DwhFile_Source') CREATE INDEX IX_DwhFile_Source ON dbo.Fact_YellowGreen_Trips(SourceDataset,SourceKey) INCLUDE(RecordHash);&#xA;IF EXISTS(SELECT 1 FROM dbo.Fact_YellowGreen_Trips WHERE SourceKey IS NULL OR SourceDataset IS NULL) THROW 55946,'Legacy facts have no source. Migrate lineage before incremental loading.',1;&#xA;&#xA;IF NOT EXISTS(SELECT 1 FROM sys.indexes WHERE object_id=OBJECT_ID('dbo.Fact_FHV_Trips') AND name='IX_DwhFile_Source') CREATE INDEX IX_DwhFile_Source ON dbo.Fact_FHV_Trips(SourceDataset,SourceKey) INCLUDE(RecordHash);&#xA;IF EXISTS(SELECT 1 FROM dbo.Fact_FHV_Trips WHERE SourceKey IS NULL OR SourceDataset IS NULL) THROW 55946,'Legacy facts have no source. Migrate lineage before incremental loading.',1;&#xA;&#xA;IF NOT EXISTS(SELECT 1 FROM sys.indexes WHERE object_id=OBJECT_ID('dbo.Fact_HVFHV_Trips') AND name='IX_DwhFile_Source') CREATE INDEX IX_DwhFile_Source ON dbo.Fact_HVFHV_Trips(SourceDataset,SourceKey) INCLUDE(RecordHash);&#xA;IF EXISTS(SELECT 1 FROM dbo.Fact_HVFHV_Trips WHERE SourceKey IS NULL OR SourceDataset IS NULL) THROW 55946,'Legacy facts have no source. Migrate lineage before incremental loading.',1;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_01_Load_Dimensions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="EST_01_Load_Dimensions - SQL Server transactional load"
      DTS:DTSID="{2A46897D-EFF9-484D-BD2D-81D8CFA66D6E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_01_Load_Dimensions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;BEGIN TRY&#xA; BEGIN TRAN;&#xA;&#xA;DECLARE @LocationMapHash char(64),@BaseMapHash char(64),@OtherMapHash char(64),@MapText nvarchar(max);&#xA;SET @MapText=(SELECT LocationKey,LocationID FROM dbo.Dim_Location ORDER BY LocationKey FOR JSON PATH);&#xA;SET @LocationMapHash=CONVERT(char(64),HASHBYTES('SHA2_256',@MapText),2);&#xA;SET @MapText=(SELECT BaseKey,BaseNumber FROM dbo.Dim_Base ORDER BY BaseKey FOR JSON PATH);&#xA;SET @BaseMapHash=CONVERT(char(64),HASHBYTES('SHA2_256',@MapText),2);&#xA;SET @MapText=CONCAT(&#xA; (SELECT ServiceTypeKey,ServiceCode FROM dbo.Dim_ServiceType ORDER BY ServiceTypeKey FOR JSON PATH),&#xA; (SELECT VendorKey,VendorID FROM dbo.Dim_Vendor ORDER BY VendorKey FOR JSON PATH),&#xA; (SELECT RateCodeKey,RateCodeID FROM dbo.Dim_RateCode ORDER BY RateCodeKey FOR JSON PATH),&#xA; (SELECT PaymentTypeKey,PaymentTypeID FROM dbo.Dim_PaymentType ORDER BY PaymentTypeKey FOR JSON PATH),&#xA; (SELECT TripTypeKey,TripTypeID FROM dbo.Dim_TripType ORDER BY TripTypeKey FOR JSON PATH),&#xA; (SELECT HVFHSProviderKey,LicenseNumber FROM dbo.Dim_HVFHSProvider ORDER BY HVFHSProviderKey FOR JSON PATH));&#xA;SET @OtherMapHash=CONVERT(char(64),HASHBYTES('SHA2_256',@MapText),2);&#xA;&#xA;DROP TABLE IF EXISTS #DwhTodo;&#xA;SELECT S.* INTO #DwhTodo FROM etl.DwhSourceState S&#xA;LEFT JOIN etl.DwhFileLog L ON L.DatasetCode=S.DatasetCode AND L.SourceKey=S.SourceKey&#xA;WHERE L.SourceKey IS NULL OR L.Status&lt;&gt;'SUCCEEDED' OR L.ForceReload=1&#xA; OR L.SourceVersion&lt;&gt;S.SourceVersion OR L.LoaderVersion&lt;&gt;CASE WHEN S.DatasetCode='fhv' THEN 'FILE_FHV_V2_20261031' ELSE 'FILE_V1_20261031' END&#xA; OR (L.UnknownMask&amp;1=1 AND L.LocationMapHash&lt;&gt;@LocationMapHash)&#xA; OR (L.UnknownMask&amp;2=2 AND L.BaseMapHash&lt;&gt;@BaseMapHash)&#xA; OR (L.UnknownMask&amp;4=4 AND L.OtherMapHash&lt;&gt;@OtherMapHash);&#xA;CREATE UNIQUE CLUSTERED INDEX IX_DwhTodo ON #DwhTodo(DatasetCode,SourceKey);&#xA;&#xA; DROP TABLE IF EXISTS #DeltaTrip;&#xA; SELECT C.* INTO #DeltaTrip&#xA; FROM #DwhTodo T JOIN NYCTaxi_Staging.clean.ValidTrip C&#xA; ON C.TaxiType=UPPER(T.DatasetCode) AND C.ETLSourceKey=T.SourceKey;&#xA;&#xA; -- All physical Dimension tables and their Unknown members come from 04_create_nyctaxi_dwh.sql.&#xA; -- 1) SCD Type 1: Taxi Zone lookup&#xA; INSERT INTO dbo.Dim_Location(LocationID,Borough,ZoneName,ServiceZone)&#xA; SELECT S.LocationID,S.Borough,S.Zone,S.ServiceZone&#xA; FROM NYCTaxi_Staging.clean.TaxiZone S&#xA; WHERE S.LocationID IS NOT NULL&#xA;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_Location D WITH (UPDLOCK,HOLDLOCK) WHERE D.LocationID=S.LocationID);&#xA; UPDATE D SET D.Borough=S.Borough, D.ZoneName=S.Zone, D.ServiceZone=S.ServiceZone&#xA; FROM dbo.Dim_Location D JOIN NYCTaxi_Staging.clean.TaxiZone S ON S.LocationID=D.LocationID&#xA; WHERE EXISTS (SELECT D.Borough,D.ZoneName,D.ServiceZone EXCEPT SELECT S.Borough,S.Zone,S.ServiceZone);&#xA; -- 2) Codes used by all four source types&#xA; INSERT dbo.Dim_ServiceType(ServiceCode,ServiceName)&#xA; SELECT V.Code,V.Name&#xA; FROM (VALUES ('YELLOW',N'Yellow Taxi'),('GREEN',N'Green Taxi'),&#xA;              ('FHV',N'For-Hire Vehicle'),('FHVHV',N'High Volume FHV')) V(Code,Name)&#xA; WHERE NOT EXISTS(SELECT 1 FROM dbo.Dim_ServiceType D WHERE D.ServiceCode=V.Code);&#xA; INSERT dbo.Dim_Vendor(VendorID)&#xA; SELECT DISTINCT C.VendorID FROM #DeltaTrip C&#xA; WHERE C.TaxiType IN('YELLOW','GREEN') AND C.VendorID IS NOT NULL&#xA;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_Vendor D WHERE D.VendorID=C.VendorID);&#xA; INSERT dbo.Dim_RateCode(RateCodeID)&#xA; SELECT DISTINCT C.RateCodeID FROM #DeltaTrip C&#xA; WHERE C.TaxiType IN('YELLOW','GREEN') AND C.RateCodeID IS NOT NULL&#xA;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_RateCode D WHERE D.RateCodeID=C.RateCodeID);&#xA; INSERT dbo.Dim_PaymentType(PaymentTypeID)&#xA; SELECT DISTINCT C.PaymentTypeID FROM #DeltaTrip C&#xA; WHERE C.TaxiType IN('YELLOW','GREEN') AND C.PaymentTypeID IS NOT NULL&#xA;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_PaymentType D WHERE D.PaymentTypeID=C.PaymentTypeID);&#xA; INSERT dbo.Dim_TripType(TripTypeID)&#xA; SELECT DISTINCT C.TripTypeID FROM #DeltaTrip C&#xA; WHERE C.TaxiType='GREEN' AND C.TripTypeID IS NOT NULL&#xA;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_TripType D WHERE D.TripTypeID=C.TripTypeID);&#xA; INSERT dbo.Dim_HVFHSProvider(LicenseNumber)&#xA; SELECT DISTINCT C.HVFHSLicenseNum FROM #DeltaTrip C&#xA; WHERE C.TaxiType='FHVHV' AND C.HVFHSLicenseNum IS NOT NULL&#xA;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_HVFHSProvider D WHERE D.LicenseNumber=C.HVFHSLicenseNum);&#xA; ;WITH Bases AS&#xA; (&#xA;   SELECT DispatchingBaseNum AS BaseNumber FROM #DeltaTrip&#xA;   UNION SELECT OriginatingBaseNum FROM #DeltaTrip&#xA;   UNION SELECT AffiliatedBaseNum FROM #DeltaTrip&#xA; )&#xA; INSERT dbo.Dim_Base(BaseNumber)&#xA; SELECT B.BaseNumber FROM Bases B&#xA; WHERE B.BaseNumber IS NOT NULL&#xA;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_Base D WHERE D.BaseNumber=B.BaseNumber);&#xA; -- 3) Junk dimensions&#xA; INSERT dbo.Dim_TaxiFlags(StoreAndFwd)&#xA; SELECT DISTINCT CASE WHEN UPPER(C.StoreAndFwdFlag) IN('Y','N') THEN UPPER(C.StoreAndFwdFlag) ELSE 'U' END&#xA; FROM #DeltaTrip C WHERE C.TaxiType IN('YELLOW','GREEN')&#xA; AND NOT EXISTS (SELECT 1 FROM dbo.Dim_TaxiFlags D&#xA;     WHERE D.StoreAndFwd=CASE WHEN UPPER(C.StoreAndFwdFlag) IN('Y','N') THEN UPPER(C.StoreAndFwdFlag) ELSE 'U' END);&#xA; INSERT dbo.Dim_FHVFlags(IsSharedRide)&#xA; SELECT DISTINCT CASE C.SourceSRFlag WHEN '1' THEN 'Y' WHEN '0' THEN 'N' ELSE 'U' END&#xA; FROM #DeltaTrip C WHERE C.TaxiType='FHV'&#xA; AND NOT EXISTS (SELECT 1 FROM dbo.Dim_FHVFlags D&#xA;     WHERE D.IsSharedRide=CASE C.SourceSRFlag WHEN '1' THEN 'Y' WHEN '0' THEN 'N' ELSE 'U' END);&#xA; ;WITH F AS&#xA; (&#xA;   SELECT DISTINCT&#xA;    CASE WHEN UPPER(SharedRequestFlag) IN('Y','N') THEN UPPER(SharedRequestFlag) ELSE 'U' END AS R,&#xA;    CASE WHEN UPPER(SharedMatchFlag) IN('Y','N') THEN UPPER(SharedMatchFlag) ELSE 'U' END AS M,&#xA;    CASE WHEN UPPER(AccessARideFlag) IN('Y','N') THEN UPPER(AccessARideFlag) ELSE 'U' END AS A,&#xA;    CASE WHEN UPPER(WAVRequestFlag) IN('Y','N') THEN UPPER(WAVRequestFlag) ELSE 'U' END AS WR,&#xA;    CASE WHEN UPPER(WAVMatchFlag) IN('Y','N') THEN UPPER(WAVMatchFlag) ELSE 'U' END AS WM&#xA;   FROM #DeltaTrip WHERE TaxiType='FHVHV'&#xA; )&#xA; INSERT dbo.Dim_HVFHVFlags(IsSharedRequest,IsSharedMatch,IsAccessARide,IsWAVRequest,IsWAVMatch)&#xA; SELECT F.R,F.M,F.A,F.WR,F.WM FROM F&#xA; WHERE NOT EXISTS (SELECT 1 FROM dbo.Dim_HVFHVFlags D&#xA;    WHERE D.IsSharedRequest=F.R AND D.IsSharedMatch=F.M AND D.IsAccessARide=F.A&#xA;    AND D.IsWAVRequest=F.WR AND D.IsWAVMatch=F.WM);&#xA; -- 4) Add dates outside seed period; IsHoliday=0 until a reliable calendar is provided.&#xA; ;WITH Dates AS&#xA; (&#xA;    SELECT CONVERT(date,PickupDateTime) AS FullDate FROM #DeltaTrip&#xA;    UNION SELECT CONVERT(date,DropoffDateTime) FROM #DeltaTrip&#xA;    UNION SELECT CONVERT(date,RequestDateTime) FROM #DeltaTrip WHERE RequestDateTime IS NOT NULL&#xA;    UNION SELECT CONVERT(date,OnSceneDateTime) FROM #DeltaTrip WHERE OnSceneDateTime IS NOT NULL&#xA; )&#xA; INSERT dbo.Dim_Date(DateKey,FullDate,DayOfWeekNumber,DayOfWeekName,DayOfMonth,MonthNumber,&#xA;                      MonthName,QuarterNumber,YearNumber,IsWeekend,IsHoliday)&#xA; SELECT YEAR(X.FullDate)*10000+MONTH(X.FullDate)*100+DAY(X.FullDate),X.FullDate,&#xA;        CONVERT(tinyint,DATEDIFF(DAY,'19000101',X.FullDate)%7+1),&#xA;        DATENAME(WEEKDAY,X.FullDate),CONVERT(tinyint,DAY(X.FullDate)),&#xA;        CONVERT(tinyint,MONTH(X.FullDate)),DATENAME(MONTH,X.FullDate),&#xA;        CONVERT(tinyint,DATEPART(QUARTER,X.FullDate)),CONVERT(smallint,YEAR(X.FullDate)),&#xA;        CASE WHEN DATEDIFF(DAY,'19000101',X.FullDate)%7 IN(5,6) THEN 1 ELSE 0 END,0&#xA; FROM Dates X WHERE X.FullDate BETWEEN '20000101' AND '20991231'&#xA; AND NOT EXISTS(SELECT 1 FROM dbo.Dim_Date D WHERE D.FullDate=X.FullDate);&#xA; -- 5) Monthly processing groups inferred from pickup dates (NOT actual file lineage).&#xA; ;WITH B AS&#xA; (&#xA;    SELECT DISTINCT C.TaxiType,&#xA;         YEAR(C.PickupDateTime) AS YY,MONTH(C.PickupDateTime) AS MM,&#xA;         CONCAT('CLEAN-',C.TaxiType,'-',CONVERT(char(6),C.PickupDateTime,112)) AS BatchID&#xA;    FROM #DeltaTrip C&#xA;    WHERE C.PickupDateTime IS NOT NULL&#xA; )&#xA; INSERT dbo.Dim_LoadBatch(BatchID,DatasetName,SourceFileName,SourceYear,SourceMonth,LoadedAt,BatchStatus)&#xA; SELECT B.BatchID,B.TaxiType,NULL,B.YY,B.MM,SYSDATETIME(),'READY'&#xA; FROM B WHERE NOT EXISTS(SELECT 1 FROM dbo.Dim_LoadBatch D WHERE D.BatchID=B.BatchID);&#xA;&#xA; SELECT (SELECT COUNT(*) FROM #DwhTodo) AS PendingFiles,&#xA;        (SELECT COUNT_BIG(*) FROM #DeltaTrip) AS DimensionInputRows;&#xA; DROP TABLE #DeltaTrip; DROP TABLE #DwhTodo;&#xA; COMMIT TRAN;&#xA;END TRY&#xA;BEGIN CATCH&#xA; IF @@TRANCOUNT&gt;0 ROLLBACK;&#xA; THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_02_Load_FactYellowGreen"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="EST_02_Load_FactYellowGreen - SQL Server transactional load"
      DTS:DTSID="{2FCC6B61-7740-4EA8-97CA-CCB34F108292}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_02_Load_FactYellowGreen"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; SET XACT_ABORT ON;&#xA;&#xA;DECLARE @LocationMapHash char(64),@BaseMapHash char(64),@OtherMapHash char(64),@MapText nvarchar(max);&#xA;SET @MapText=(SELECT LocationKey,LocationID FROM dbo.Dim_Location ORDER BY LocationKey FOR JSON PATH);&#xA;SET @LocationMapHash=CONVERT(char(64),HASHBYTES('SHA2_256',@MapText),2);&#xA;SET @MapText=(SELECT BaseKey,BaseNumber FROM dbo.Dim_Base ORDER BY BaseKey FOR JSON PATH);&#xA;SET @BaseMapHash=CONVERT(char(64),HASHBYTES('SHA2_256',@MapText),2);&#xA;SET @MapText=CONCAT(&#xA; (SELECT ServiceTypeKey,ServiceCode FROM dbo.Dim_ServiceType ORDER BY ServiceTypeKey FOR JSON PATH),&#xA; (SELECT VendorKey,VendorID FROM dbo.Dim_Vendor ORDER BY VendorKey FOR JSON PATH),&#xA; (SELECT RateCodeKey,RateCodeID FROM dbo.Dim_RateCode ORDER BY RateCodeKey FOR JSON PATH),&#xA; (SELECT PaymentTypeKey,PaymentTypeID FROM dbo.Dim_PaymentType ORDER BY PaymentTypeKey FOR JSON PATH),&#xA; (SELECT TripTypeKey,TripTypeID FROM dbo.Dim_TripType ORDER BY TripTypeKey FOR JSON PATH),&#xA; (SELECT HVFHSProviderKey,LicenseNumber FROM dbo.Dim_HVFHSProvider ORDER BY HVFHSProviderKey FOR JSON PATH));&#xA;SET @OtherMapHash=CONVERT(char(64),HASHBYTES('SHA2_256',@MapText),2);&#xA;&#xA;&#xA;DROP TABLE IF EXISTS #DwhTodo;&#xA;SELECT S.* INTO #DwhTodo FROM etl.DwhSourceState S&#xA;LEFT JOIN etl.DwhFileLog L ON L.DatasetCode=S.DatasetCode AND L.SourceKey=S.SourceKey&#xA;WHERE L.SourceKey IS NULL OR L.Status&lt;&gt;'SUCCEEDED' OR L.ForceReload=1&#xA; OR L.SourceVersion&lt;&gt;S.SourceVersion OR L.LoaderVersion&lt;&gt;CASE WHEN S.DatasetCode='fhv' THEN 'FILE_FHV_V2_20261031' ELSE 'FILE_V1_20261031' END&#xA; OR (L.UnknownMask&amp;1=1 AND L.LocationMapHash&lt;&gt;@LocationMapHash)&#xA; OR (L.UnknownMask&amp;2=2 AND L.BaseMapHash&lt;&gt;@BaseMapHash)&#xA; OR (L.UnknownMask&amp;4=4 AND L.OtherMapHash&lt;&gt;@OtherMapHash);&#xA;CREATE UNIQUE CLUSTERED INDEX IX_DwhTodo ON #DwhTodo(DatasetCode,SourceKey);&#xA;&#xA;DELETE FROM #DwhTodo WHERE DatasetCode NOT IN ('yellow','green');&#xA;DECLARE @Dataset varchar(20),@Source nvarchar(260),@Expected bigint,@Token char(64),&#xA; @Inserted bigint=0,@Updated bigint=0,@Deleted bigint=0,@FactRows bigint,@Unknown int,&#xA; @Files int=0,@Input bigint=0,@Error nvarchar(max);&#xA;DECLARE FileCursor CURSOR LOCAL FAST_FORWARD FOR SELECT DatasetCode,SourceKey,ValidRows,SourceVersion FROM #DwhTodo ORDER BY DatasetCode,SourceKey;&#xA;OPEN FileCursor; FETCH NEXT FROM FileCursor INTO @Dataset,@Source,@Expected,@Token;&#xA;WHILE @@FETCH_STATUS=0&#xA;BEGIN&#xA; BEGIN TRY&#xA;  BEGIN TRANSACTION;&#xA;  DROP TABLE IF EXISTS #CurrentFile; DROP TABLE IF EXISTS #Desired;&#xA;  SELECT * INTO #CurrentFile FROM #DwhTodo WHERE DatasetCode=@Dataset AND SourceKey=@Source;&#xA;  IF NOT EXISTS(SELECT 1 FROM etl.DwhSourceState WITH(HOLDLOCK) WHERE DatasetCode=@Dataset AND SourceKey=@Source AND SourceVersion=@Token)&#xA;   THROW 55940,'Source changed after DWH planning; retry after Transform.',1;&#xA;  IF EXISTS(SELECT 1 FROM NYCTaxi_Staging.clean.Trip C JOIN #CurrentFile P&#xA;    ON C.TaxiType=UPPER(P.DatasetCode) AND C.ETLSourceKey=P.SourceKey&#xA;    WHERE C.ETLFileHash IS NULL OR C.ETLFileHash&lt;&gt;P.FileHash)&#xA;   THROW 55947,'File clean lineage hash disagrees with Transform checkpoint.',1;&#xA;  IF (SELECT COUNT_BIG(*) FROM NYCTaxi_Staging.clean.Trip WHERE TaxiType=UPPER(@Dataset) AND ETLSourceKey=@Source)&#xA;   &lt;&gt;(SELECT SourceRows FROM #CurrentFile)&#xA;   THROW 55948,'File clean row coverage is incomplete.',1;&#xA;;WITH SourceRows AS&#xA;(&#xA;  SELECT C.*,&#xA;    HASHBYTES('SHA2_256',&#xA;      (SELECT C.TaxiType AS TaxiType,&#xA;            C.VendorID AS VendorID,&#xA;            C.HVFHSLicenseNum AS HVFHSLicenseNum,&#xA;            C.DispatchingBaseNum AS DispatchingBaseNum,&#xA;            C.OriginatingBaseNum AS OriginatingBaseNum,&#xA;            C.AffiliatedBaseNum AS AffiliatedBaseNum,&#xA;            C.RequestDateTime AS RequestDateTime,&#xA;            C.OnSceneDateTime AS OnSceneDateTime,&#xA;            C.PickupDateTime AS PickupDateTime,&#xA;            C.DropoffDateTime AS DropoffDateTime,&#xA;            C.TripDurationSeconds AS TripDurationSeconds,&#xA;            C.PULocationID AS PULocationID,&#xA;            C.DOLocationID AS DOLocationID,&#xA;            C.PassengerCount AS PassengerCount,&#xA;            C.TripDistanceMiles AS TripDistanceMiles,&#xA;            C.RateCodeID AS RateCodeID,&#xA;            C.PaymentTypeID AS PaymentTypeID,&#xA;            C.TripTypeID AS TripTypeID,&#xA;            C.StoreAndFwdFlag AS StoreAndFwdFlag,&#xA;            C.FareAmount AS FareAmount,&#xA;            C.ExtraAmount AS ExtraAmount,&#xA;            C.MTATaxAmount AS MTATaxAmount,&#xA;            C.TipAmount AS TipAmount,&#xA;            C.TollsAmount AS TollsAmount,&#xA;            C.ImprovementSurcharge AS ImprovementSurcharge,&#xA;            C.CongestionSurcharge AS CongestionSurcharge,&#xA;            C.AirportFee AS AirportFee,&#xA;            C.CBDCongestionFee AS CBDCongestionFee,&#xA;            C.BCFAmount AS BCFAmount,&#xA;            C.SalesTaxAmount AS SalesTaxAmount,&#xA;            C.DriverPayAmount AS DriverPayAmount,&#xA;            C.TotalAmount AS TotalAmount,&#xA;            C.IsTotalCalculated AS IsTotalCalculated,&#xA;            C.SharedRequestFlag AS SharedRequestFlag,&#xA;            C.SharedMatchFlag AS SharedMatchFlag,&#xA;            C.AccessARideFlag AS AccessARideFlag,&#xA;            C.WAVRequestFlag AS WAVRequestFlag,&#xA;            C.WAVMatchFlag AS WAVMatchFlag&#xA;       FOR JSON PATH, WITHOUT_ARRAY_WRAPPER, INCLUDE_NULL_VALUES)&#xA;    ) AS PayloadHash&#xA;  FROM NYCTaxi_Staging.clean.ValidTrip C&#xA;  INNER JOIN #CurrentFile F ON C.TaxiType=UPPER(F.DatasetCode) AND C.ETLSourceKey=F.SourceKey&#xA;  WHERE C.TaxiType IN ('YELLOW','GREEN')&#xA;),&#xA;Ranked AS&#xA;(&#xA;  SELECT S.*, ROW_NUMBER() OVER(PARTITION BY S.TaxiType,S.ETLSourceKey,S.PayloadHash ORDER BY S.TripCleanID) AS DuplicateOrdinal&#xA;  FROM SourceRows S&#xA;),&#xA;Tagged AS&#xA;(&#xA;  SELECT R.*,&#xA;    HASHBYTES('SHA2_256', CONCAT(R.TaxiType,'|',R.ETLSourceKey,'|',CONVERT(varchar(64),R.PayloadHash,2),':',R.DuplicateOrdinal)) AS RecordHash&#xA;  FROM Ranked R&#xA;),&#xA;FactValues AS (&#xA;SELECT&#xA;    COALESCE(PickupDate.DateKey, 0) AS PickupDateKey,&#xA;    COALESCE(DropoffDate.DateKey, 0) AS DropoffDateKey,&#xA;&#xA;    COALESCE(PickupTime.TimeKey, 0) AS PickupTimeKey,&#xA;    COALESCE(DropoffTime.TimeKey, 0) AS DropoffTimeKey,&#xA;&#xA;    COALESCE(PickupZone.LocationKey, 0) AS PickupLocationKey,&#xA;    COALESCE(DropoffZone.LocationKey, 0) AS DropoffLocationKey,&#xA;&#xA;    COALESCE(ServiceType.ServiceTypeKey, 0) AS ServiceTypeKey,&#xA;    COALESCE(Vendor.VendorKey, 0) AS VendorKey,&#xA;    COALESCE(RateCode.RateCodeKey, 0) AS RateCodeKey,&#xA;    COALESCE(Payment.PaymentTypeKey, 0) AS PaymentTypeKey,&#xA;    COALESCE(TripType.TripTypeKey, 0) AS TripTypeKey,&#xA;    COALESCE(TaxiFlag.TaxiFlagKey, 0) AS TaxiFlagKey,&#xA;    COALESCE(PassengerGroup.PassengerGroupKey, 0)&#xA;        AS PassengerGroupKey,&#xA;&#xA;    COALESCE(LoadBatch.LoadBatchKey,0) AS LoadBatchKey,&#xA;    1 AS TripCount,&#xA;&#xA;    C.PassengerCount,&#xA;    C.TripDistanceMiles,&#xA;    C.TripDurationSeconds,&#xA;&#xA;    CASE&#xA;        WHEN C.TripDurationSeconds &gt; 0&#xA;             AND C.TripDistanceMiles &gt;= 0&#xA;        THEN CONVERT&#xA;        (&#xA;            DECIMAL(12,3),&#xA;            C.TripDistanceMiles * 3600.0&#xA;            / C.TripDurationSeconds&#xA;        )&#xA;        ELSE NULL&#xA;    END AS AverageSpeedMPH,&#xA;&#xA;    C.FareAmount,&#xA;    C.ExtraAmount,&#xA;    C.MTATaxAmount,&#xA;    C.TipAmount,&#xA;    C.TollsAmount,&#xA;    C.ImprovementSurcharge,&#xA;    C.CongestionSurcharge,&#xA;    C.AirportFee,&#xA;    C.CBDCongestionFee,&#xA;    C.TotalAmount,&#xA;    C.RecordHash AS RecordHash, LOWER(C.TaxiType) AS SourceDataset, C.ETLSourceKey AS SourceKey,&#xA;    CASE WHEN (C.PULocationID IS NOT NULL AND COALESCE(PickupZone.LocationKey,0)=0) OR (C.DOLocationID IS NOT NULL AND COALESCE(DropoffZone.LocationKey,0)=0) THEN 1 ELSE 0 END + CASE WHEN (C.VendorID IS NOT NULL AND COALESCE(Vendor.VendorKey,0)=0) OR (C.RateCodeID IS NOT NULL AND COALESCE(RateCode.RateCodeKey,0)=0) OR (C.PaymentTypeID IS NOT NULL AND COALESCE(Payment.PaymentTypeKey,0)=0) OR (C.TripTypeID IS NOT NULL AND COALESCE(TripType.TripTypeKey,0)=0) THEN 4 ELSE 0 END AS UnresolvedMask&#xA;&#xA;FROM Tagged AS C&#xA;&#xA;LEFT JOIN dbo.Dim_Date AS PickupDate&#xA;    ON PickupDate.FullDate =&#xA;       CONVERT(DATE, C.PickupDateTime)&#xA;&#xA;LEFT JOIN dbo.Dim_Date AS DropoffDate&#xA;    ON DropoffDate.FullDate =&#xA;       CONVERT(DATE, C.DropoffDateTime)&#xA;&#xA;LEFT JOIN dbo.Dim_Time AS PickupTime&#xA;    ON PickupTime.MinuteOfDay =&#xA;       DATEPART(HOUR, C.PickupDateTime) * 60&#xA;       + DATEPART(MINUTE, C.PickupDateTime)&#xA;&#xA;LEFT JOIN dbo.Dim_Time AS DropoffTime&#xA;    ON DropoffTime.MinuteOfDay =&#xA;       DATEPART(HOUR, C.DropoffDateTime) * 60&#xA;       + DATEPART(MINUTE, C.DropoffDateTime)&#xA;&#xA;LEFT JOIN dbo.Dim_Location AS PickupZone&#xA;    ON PickupZone.LocationID = C.PULocationID&#xA;&#xA;LEFT JOIN dbo.Dim_Location AS DropoffZone&#xA;    ON DropoffZone.LocationID = C.DOLocationID&#xA;&#xA;LEFT JOIN dbo.Dim_ServiceType AS ServiceType&#xA;    ON ServiceType.ServiceCode = C.TaxiType&#xA;&#xA;LEFT JOIN dbo.Dim_Vendor AS Vendor&#xA;    ON Vendor.VendorID = C.VendorID&#xA;&#xA;LEFT JOIN dbo.Dim_RateCode AS RateCode&#xA;    ON RateCode.RateCodeID = C.RateCodeID&#xA;&#xA;LEFT JOIN dbo.Dim_PaymentType AS Payment&#xA;    ON Payment.PaymentTypeID = C.PaymentTypeID&#xA;&#xA;LEFT JOIN dbo.Dim_TripType AS TripType&#xA;    ON TripType.TripTypeID = C.TripTypeID&#xA;&#xA;LEFT JOIN dbo.Dim_TaxiFlags AS TaxiFlag&#xA;    ON TaxiFlag.StoreAndFwd =&#xA;       CASE&#xA;           WHEN UPPER(C.StoreAndFwdFlag) IN ('Y', 'N')&#xA;               THEN UPPER(C.StoreAndFwdFlag)&#xA;           ELSE 'U'&#xA;       END&#xA;&#xA;LEFT JOIN dbo.Dim_PassengerGroup AS PassengerGroup&#xA;    ON C.PassengerCount BETWEEN&#xA;       PassengerGroup.MinCount AND PassengerGroup.MaxCount&#xA;&#xA;LEFT JOIN dbo.Dim_LoadBatch AS LoadBatch&#xA;    ON LoadBatch.BatchID = CONCAT('CLEAN-',C.TaxiType,'-',CONVERT(char(6),C.PickupDateTime,112))&#xA;&#xA;WHERE C.TaxiType IN ('YELLOW', 'GREEN')&#xA;)&#xA;&#xA;  SELECT * INTO #Desired FROM FactValues;&#xA;  CREATE UNIQUE CLUSTERED INDEX IX_Desired_Hash ON #Desired(RecordHash);&#xA;  IF (SELECT COUNT_BIG(*) FROM #Desired)&lt;&gt;@Expected&#xA;   THROW 55941,'File clean rows disagree with Transform checkpoint.',1;&#xA;  IF EXISTS(SELECT 1 FROM #Desired WHERE ServiceTypeKey=0)&#xA;   THROW 55942,'Unknown ServiceTypeKey in changed file.',1;&#xA;  INSERT etl.FactChangeAudit(TableName,RowJson)&#xA;   SELECT N'Fact_YellowGreen_Trips',(SELECT F.* FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)&#xA;   FROM dbo.Fact_YellowGreen_Trips F&#xA;   WHERE F.SourceDataset=@Dataset AND F.SourceKey=@Source&#xA;     AND NOT EXISTS(SELECT 1 FROM #Desired V WHERE V.RecordHash=F.RecordHash);&#xA;  DELETE F FROM dbo.Fact_YellowGreen_Trips F&#xA;   WHERE F.SourceDataset=@Dataset AND F.SourceKey=@Source&#xA;     AND NOT EXISTS(SELECT 1 FROM #Desired V WHERE V.RecordHash=F.RecordHash);&#xA;  SET @Deleted=@@ROWCOUNT;&#xA;  UPDATE F SET PickupDateKey=V.PickupDateKey,DropoffDateKey=V.DropoffDateKey,PickupTimeKey=V.PickupTimeKey,DropoffTimeKey=V.DropoffTimeKey,PickupLocationKey=V.PickupLocationKey,DropoffLocationKey=V.DropoffLocationKey,ServiceTypeKey=V.ServiceTypeKey,VendorKey=V.VendorKey,RateCodeKey=V.RateCodeKey,PaymentTypeKey=V.PaymentTypeKey,TripTypeKey=V.TripTypeKey,TaxiFlagKey=V.TaxiFlagKey,PassengerGroupKey=V.PassengerGroupKey,LoadBatchKey=V.LoadBatchKey,TripCount=V.TripCount,PassengerCount=V.PassengerCount,TripDistanceMiles=V.TripDistanceMiles,TripDurationSeconds=V.TripDurationSeconds,AverageSpeedMPH=V.AverageSpeedMPH,FareAmount=V.FareAmount,ExtraAmount=V.ExtraAmount,MTATaxAmount=V.MTATaxAmount,TipAmount=V.TipAmount,TollsAmount=V.TollsAmount,ImprovementSurcharge=V.ImprovementSurcharge,CongestionSurcharge=V.CongestionSurcharge,AirportFee=V.AirportFee,CBDCongestionFee=V.CBDCongestionFee,TotalAmount=V.TotalAmount,SourceDataset=V.SourceDataset,SourceKey=V.SourceKey&#xA;   FROM dbo.Fact_YellowGreen_Trips F JOIN #Desired V ON V.RecordHash=F.RecordHash&#xA;   WHERE F.SourceDataset=@Dataset AND F.SourceKey=@Source&#xA;     AND EXISTS(SELECT F.PickupDateKey,F.DropoffDateKey,F.PickupTimeKey,F.DropoffTimeKey,F.PickupLocationKey,F.DropoffLocationKey,F.ServiceTypeKey,F.VendorKey,F.RateCodeKey,F.PaymentTypeKey,F.TripTypeKey,F.TaxiFlagKey,F.PassengerGroupKey,F.LoadBatchKey,F.TripCount,F.PassengerCount,F.TripDistanceMiles,F.TripDurationSeconds,F.AverageSpeedMPH,F.FareAmount,F.ExtraAmount,F.MTATaxAmount,F.TipAmount,F.TollsAmount,F.ImprovementSurcharge,F.CongestionSurcharge,F.AirportFee,F.CBDCongestionFee,F.TotalAmount,F.SourceDataset,F.SourceKey EXCEPT SELECT V.PickupDateKey,V.DropoffDateKey,V.PickupTimeKey,V.DropoffTimeKey,V.PickupLocationKey,V.DropoffLocationKey,V.ServiceTypeKey,V.VendorKey,V.RateCodeKey,V.PaymentTypeKey,V.TripTypeKey,V.TaxiFlagKey,V.PassengerGroupKey,V.LoadBatchKey,V.TripCount,V.PassengerCount,V.TripDistanceMiles,V.TripDurationSeconds,V.AverageSpeedMPH,V.FareAmount,V.ExtraAmount,V.MTATaxAmount,V.TipAmount,V.TollsAmount,V.ImprovementSurcharge,V.CongestionSurcharge,V.AirportFee,V.CBDCongestionFee,V.TotalAmount,V.SourceDataset,V.SourceKey);&#xA;  SET @Updated=@@ROWCOUNT;&#xA;    INSERT INTO dbo.Fact_YellowGreen_Trips&#xA;    (PickupDateKey, DropoffDateKey, PickupTimeKey, DropoffTimeKey, PickupLocationKey, DropoffLocationKey, ServiceTypeKey, VendorKey, RateCodeKey, PaymentTypeKey, TripTypeKey, TaxiFlagKey, PassengerGroupKey, LoadBatchKey, TripCount, PassengerCount, TripDistanceMiles, TripDurationSeconds, AverageSpeedMPH, FareAmount, ExtraAmount, MTATaxAmount, TipAmount, TollsAmount, ImprovementSurcharge, CongestionSurcharge, AirportFee, CBDCongestionFee, TotalAmount, RecordHash, SourceDataset, SourceKey)&#xA;    SELECT V.PickupDateKey, V.DropoffDateKey, V.PickupTimeKey, V.DropoffTimeKey, V.PickupLocationKey, V.DropoffLocationKey, V.ServiceTypeKey, V.VendorKey, V.RateCodeKey, V.PaymentTypeKey, V.TripTypeKey, V.TaxiFlagKey, V.PassengerGroupKey, V.LoadBatchKey, V.TripCount, V.PassengerCount, V.TripDistanceMiles, V.TripDurationSeconds, V.AverageSpeedMPH, V.FareAmount, V.ExtraAmount, V.MTATaxAmount, V.TipAmount, V.TollsAmount, V.ImprovementSurcharge, V.CongestionSurcharge, V.AirportFee, V.CBDCongestionFee, V.TotalAmount, V.RecordHash, V.SourceDataset, V.SourceKey&#xA;    FROM #Desired V&#xA;    WHERE NOT EXISTS&#xA;      (SELECT 1 FROM dbo.Fact_YellowGreen_Trips F WITH (UPDLOCK,HOLDLOCK) WHERE F.RecordHash=V.RecordHash);&#xA;&#xA;  SET @Inserted=@@ROWCOUNT;&#xA;  IF TRY_CONVERT(int,SESSION_CONTEXT(N'NYCTaxiFailAfterFactWrite'))=1&#xA;   THROW 55949,'Injected failure after Fact write, before checkpoint.',1;&#xA;  SELECT @FactRows=COUNT_BIG(*) FROM dbo.Fact_YellowGreen_Trips WHERE SourceDataset=@Dataset AND SourceKey=@Source;&#xA;  IF @FactRows&lt;&gt;@Expected THROW 55943,'File Fact reconciliation failed.',1;&#xA;  SELECT @Unknown=COALESCE(MAX(UnresolvedMask&amp;1),0)+COALESCE(MAX(UnresolvedMask&amp;2),0)+COALESCE(MAX(UnresolvedMask&amp;4),0) FROM #Desired;&#xA;  DELETE etl.DwhFileLog WHERE DatasetCode=@Dataset AND SourceKey=@Source;&#xA;  INSERT etl.DwhFileLog(DatasetCode,SourceKey,SourceVersion,LoaderVersion,Status,ForceReload,&#xA;   ValidRows,FactRows,InsertedRows,UpdatedRows,DeletedRows,UnknownMask,LocationMapHash,BaseMapHash,OtherMapHash,CompletedAt)&#xA;  VALUES(@Dataset,@Source,@Token,'FILE_V1_20261031','SUCCEEDED',0,@Expected,@FactRows,@Inserted,@Updated,@Deleted,@Unknown,&#xA;   @LocationMapHash,@BaseMapHash,@OtherMapHash,SYSUTCDATETIME());&#xA;  INSERT etl.LoadStepLog(StepName,InsertedRows) VALUES(N'Fact_YellowGreen_Trips',@Inserted);&#xA;  COMMIT TRANSACTION;&#xA;  SET @Files+=1; SET @Input+=@Expected;&#xA; END TRY&#xA; BEGIN CATCH&#xA;  SET @Error=ERROR_MESSAGE(); IF @@TRANCOUNT&gt;0 ROLLBACK;&#xA;  IF NOT EXISTS(SELECT 1 FROM etl.DwhFileLog WHERE DatasetCode=@Dataset AND SourceKey=@Source)&#xA;   INSERT etl.DwhFileLog(DatasetCode,SourceKey,Status,ErrorMessage) VALUES(@Dataset,@Source,'FAILED',@Error);&#xA;  ELSE UPDATE etl.DwhFileLog SET Status='FAILED',ErrorMessage=@Error WHERE DatasetCode=@Dataset AND SourceKey=@Source;&#xA;  CLOSE FileCursor; DEALLOCATE FileCursor; THROW;&#xA; END CATCH;&#xA; FETCH NEXT FROM FileCursor INTO @Dataset,@Source,@Expected,@Token;&#xA;END;&#xA;CLOSE FileCursor; DEALLOCATE FileCursor;&#xA;DROP TABLE IF EXISTS #Desired; DROP TABLE IF EXISTS #CurrentFile; DROP TABLE #DwhTodo;&#xA;SELECT @Files AS ProcessedFiles,@Input AS ValidInputRows;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_03_Load_FactFHV"
