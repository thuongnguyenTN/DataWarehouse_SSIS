      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.TaxiZone&#xA;)&#xA;    THROW 50010, 'clean.TaxiZone khong co du lieu.', 1;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.Trip&#xA;    WHERE TaxiType = 'YELLOW'&#xA;)&#xA;    THROW 50011, 'Khong co du lieu YELLOW trong clean.Trip.', 1;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.Trip&#xA;    WHERE TaxiType = 'GREEN'&#xA;)&#xA;    THROW 50012, 'Khong co du lieu GREEN trong clean.Trip.', 1;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.Trip&#xA;    WHERE TaxiType = 'FHV'&#xA;)&#xA;    THROW 50013, 'Khong co du lieu FHV trong clean.Trip.', 1;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.Trip&#xA;    WHERE TaxiType = 'FHVHV'&#xA;)&#xA;    THROW 50014, 'Khong co du lieu FHVHV trong clean.Trip.', 1;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM clean.Trip&#xA;    WHERE TaxiType NOT IN&#xA;    (&#xA;        'YELLOW',&#xA;        'GREEN',&#xA;        'FHV',&#xA;        'FHVHV'&#xA;    )&#xA;)&#xA;    THROW 50015, 'Phat hien TaxiType khong hop le.', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
