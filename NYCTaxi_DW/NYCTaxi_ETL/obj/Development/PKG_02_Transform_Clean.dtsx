    <DTS:Executable
      DTS:refId="Package\EST_Transform_FHV"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{674592DF-297E-4EE5-9239-03D1FD08FC67}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_Transform_FHV"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF OBJECT_ID('clean.Trip', 'U') IS NULL&#xA;    THROW 50001, 'Chay 00_setup_clean.sql truoc.', 1;&#xA;&#xA;DELETE FROM clean.Trip&#xA;WHERE TaxiType = 'FHV';&#xA;&#xA;;WITH S AS&#xA;(&#xA;    SELECT TOP (100000)&#xA;        NULLIF(&#xA;            LTRIM(RTRIM(dispatching_base_num)),&#xA;            ''&#xA;        ) AS DispatchingBaseNum,&#xA;&#xA;        NULLIF(&#xA;            LTRIM(RTRIM(Affiliated_base_number)),&#xA;            ''&#xA;        ) AS AffiliatedBaseNum,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(pickup_datetime)), '')&#xA;        ) AS PickupDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(dropOff_datetime)), '')&#xA;        ) AS DropoffDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(PULocationID)), '')&#xA;        ) AS PULocationID,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(DOLocationID)), '')&#xA;        ) AS DOLocationID,&#xA;&#xA;        UPPER(&#xA;            NULLIF(LTRIM(RTRIM(SR_Flag)), '')&#xA;        ) AS SharedRequestFlag&#xA;    FROM stg.FHVTrip&#xA;),&#xA;T AS&#xA;(&#xA;    SELECT&#xA;        *,&#xA;        CASE&#xA;            WHEN PickupDT IS NULL&#xA;              OR DropoffDT IS NULL&#xA;              OR DropoffDT &lt;= PickupDT&#xA;              OR DATEDIFF_BIG(SECOND, PickupDT, DropoffDT) &gt; 172800&#xA;            THEN CONVERT(BIT, 0)&#xA;            ELSE CONVERT(BIT, 1)&#xA;        END AS IsCoreValid,&#xA;&#xA;        NULLIF(&#xA;            CONCAT(&#xA;                CASE WHEN PickupDT IS NULL&#xA;                     THEN 'PICKUP_INVALID;' ELSE '' END,&#xA;&#xA;                CASE WHEN DropoffDT IS NULL&#xA;                     THEN 'DROPOFF_INVALID;' ELSE '' END,&#xA;&#xA;                CASE WHEN PickupDT IS NOT NULL&#xA;                           AND DropoffDT IS NOT NULL&#xA;                           AND DropoffDT &lt;= PickupDT&#xA;                     THEN 'DURATION_NON_POSITIVE;' ELSE '' END,&#xA;&#xA;                CASE WHEN PickupDT IS NOT NULL&#xA;                           AND DropoffDT IS NOT NULL&#xA;                           AND DATEDIFF_BIG(&#xA;                               SECOND,&#xA;                               PickupDT,&#xA;                               DropoffDT&#xA;                           ) &gt; 172800&#xA;                     THEN 'DURATION_OVER_48H;' ELSE '' END&#xA;            ),&#xA;            ''&#xA;        ) AS QualityIssue&#xA;    FROM S&#xA;)&#xA;INSERT INTO clean.Trip&#xA;(&#xA;    TaxiType,&#xA;    DispatchingBaseNum,&#xA;    AffiliatedBaseNum,&#xA;    PickupDateTime,&#xA;    DropoffDateTime,&#xA;    TripDurationSeconds,&#xA;    PULocationID,&#xA;    DOLocationID,&#xA;    SharedRequestFlag,&#xA;    IsTotalCalculated,&#xA;    IsCoreValid,&#xA;    QualityIssue&#xA;)&#xA;SELECT&#xA;    'FHV',&#xA;    DispatchingBaseNum,&#xA;    AffiliatedBaseNum,&#xA;    PickupDT,&#xA;    DropoffDT,&#xA;    CASE&#xA;        WHEN PickupDT IS NOT NULL AND DropoffDT IS NOT NULL&#xA;        THEN DATEDIFF_BIG(SECOND, PickupDT, DropoffDT)&#xA;    END,&#xA;    PULocationID,&#xA;    DOLocationID,&#xA;    SharedRequestFlag,&#xA;    0,&#xA;    IsCoreValid,&#xA;    QualityIssue&#xA;FROM T;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_Transform_FHVHV"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3F8B5B11-AEFF-47E0-B53C-71E89F291F8F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_Transform_FHVHV"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF OBJECT_ID('clean.Trip', 'U') IS NULL&#xA;    THROW 50001, 'Chay 00_setup_clean.sql truoc.', 1;&#xA;&#xA;DELETE FROM clean.Trip&#xA;WHERE TaxiType = 'FHVHV';&#xA;&#xA;;WITH S AS&#xA;(&#xA;    SELECT TOP (100000)&#xA;        NULLIF(&#xA;            LTRIM(RTRIM(hvfhs_license_num)),&#xA;            ''&#xA;        ) AS HVFHSLicenseNum,&#xA;&#xA;        NULLIF(&#xA;            LTRIM(RTRIM(dispatching_base_num)),&#xA;            ''&#xA;        ) AS DispatchingBaseNum,&#xA;&#xA;        NULLIF(&#xA;            LTRIM(RTRIM(originating_base_num)),&#xA;            ''&#xA;        ) AS OriginatingBaseNum,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(request_datetime)), '')&#xA;        ) AS RequestDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(on_scene_datetime)), '')&#xA;        ) AS OnSceneDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(pickup_datetime)), '')&#xA;        ) AS PickupDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(dropoff_datetime)), '')&#xA;        ) AS DropoffDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(PULocationID)), '')&#xA;        ) AS PULocationID,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(DOLocationID)), '')&#xA;        ) AS DOLocationID,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(12,3),&#xA;            NULLIF(LTRIM(RTRIM(trip_miles)), '')&#xA;        ) AS TripDistance,&#xA;&#xA;        TRY_CONVERT(&#xA;            BIGINT,&#xA;            NULLIF(LTRIM(RTRIM(trip_time)), '')&#xA;        ) AS SourceTripTime,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(base_passenger_fare)), '')&#xA;        ) AS FareAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(tolls)), '')&#xA;        ) AS TollsAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(bcf)), '')&#xA;        ) AS BCFAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(sales_tax)), '')&#xA;        ) AS SalesTaxAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(congestion_surcharge)), '')&#xA;        ) AS CongestionSurcharge,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(airport_fee)), '')&#xA;        ) AS AirportFee,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(tips)), '')&#xA;        ) AS TipAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(driver_pay)), '')&#xA;        ) AS DriverPayAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(cbd_congestion_fee)), '')&#xA;        ) AS CBDCongestionFee,&#xA;&#xA;        UPPER(&#xA;            NULLIF(LTRIM(RTRIM(shared_request_flag)), '')&#xA;        ) AS SharedRequestFlag,&#xA;&#xA;        UPPER(&#xA;            NULLIF(LTRIM(RTRIM(shared_match_flag)), '')&#xA;        ) AS SharedMatchFlag,&#xA;&#xA;        UPPER(&#xA;            NULLIF(LTRIM(RTRIM(access_a_ride_flag)), '')&#xA;        ) AS AccessARideFlag,&#xA;&#xA;        UPPER(&#xA;            NULLIF(LTRIM(RTRIM(wav_request_flag)), '')&#xA;        ) AS WAVRequestFlag,&#xA;&#xA;        UPPER(&#xA;            NULLIF(LTRIM(RTRIM(wav_match_flag)), '')&#xA;        ) AS WAVMatchFlag&#xA;    FROM stg.FHVHVTrip&#xA;),&#xA;T AS&#xA;(&#xA;    SELECT&#xA;        *,&#xA;&#xA;        COALESCE&#xA;        (&#xA;            SourceTripTime,&#xA;            CASE&#xA;                WHEN PickupDT IS NOT NULL AND DropoffDT IS NOT NULL&#xA;                THEN DATEDIFF_BIG(SECOND, PickupDT, DropoffDT)&#xA;            END&#xA;        ) AS DurationSeconds,&#xA;&#xA;        CAST&#xA;        (&#xA;            COALESCE(FareAmount, 0)&#xA;            + COALESCE(TollsAmount, 0)&#xA;            + COALESCE(BCFAmount, 0)&#xA;            + COALESCE(SalesTaxAmount, 0)&#xA;            + COALESCE(CongestionSurcharge, 0)&#xA;            + COALESCE(AirportFee, 0)&#xA;            + COALESCE(TipAmount, 0)&#xA;            + COALESCE(CBDCongestionFee, 0)&#xA;            AS DECIMAL(18,2)&#xA;        ) AS CalculatedTotal&#xA;    FROM S&#xA;),&#xA;Q AS&#xA;(&#xA;    SELECT&#xA;        *,&#xA;        CASE&#xA;            WHEN PickupDT IS NULL&#xA;              OR DropoffDT IS NULL&#xA;              OR DropoffDT &lt;= PickupDT&#xA;              OR DurationSeconds &lt;= 0&#xA;              OR DurationSeconds &gt; 172800&#xA;              OR TripDistance &lt; 0&#xA;            THEN CONVERT(BIT, 0)&#xA;            ELSE CONVERT(BIT, 1)&#xA;        END AS IsCoreValid,&#xA;&#xA;        NULLIF(&#xA;            CONCAT(&#xA;                CASE WHEN RequestDT IS NULL&#xA;                     THEN 'REQUEST_INVALID;' ELSE '' END,&#xA;&#xA;                CASE WHEN PickupDT IS NULL&#xA;                     THEN 'PICKUP_INVALID;' ELSE '' END,&#xA;&#xA;                CASE WHEN DropoffDT IS NULL&#xA;                     THEN 'DROPOFF_INVALID;' ELSE '' END,&#xA;&#xA;                CASE WHEN PickupDT IS NOT NULL&#xA;                           AND DropoffDT IS NOT NULL&#xA;                           AND DropoffDT &lt;= PickupDT&#xA;                     THEN 'DURATION_NON_POSITIVE;' ELSE '' END,&#xA;&#xA;                CASE WHEN DurationSeconds &gt; 172800&#xA;                     THEN 'DURATION_OVER_48H;' ELSE '' END,&#xA;&#xA;                CASE WHEN TripDistance &lt; 0&#xA;                     THEN 'DISTANCE_NEGATIVE;' ELSE '' END,&#xA;&#xA;                CASE WHEN CalculatedTotal &lt; 0&#xA;                     THEN 'TOTAL_NEGATIVE;' ELSE '' END&#xA;            ),&#xA;            ''&#xA;        ) AS QualityIssue&#xA;    FROM T&#xA;)&#xA;INSERT INTO clean.Trip&#xA;(&#xA;    TaxiType,&#xA;    HVFHSLicenseNum,&#xA;    DispatchingBaseNum,&#xA;    OriginatingBaseNum,&#xA;    RequestDateTime,&#xA;    OnSceneDateTime,&#xA;    PickupDateTime,&#xA;    DropoffDateTime,&#xA;    TripDurationSeconds,&#xA;    PULocationID,&#xA;    DOLocationID,&#xA;    TripDistanceMiles,&#xA;    FareAmount,&#xA;    TipAmount,&#xA;    TollsAmount,&#xA;    CongestionSurcharge,&#xA;    AirportFee,&#xA;    CBDCongestionFee,&#xA;    BCFAmount,&#xA;    SalesTaxAmount,&#xA;    DriverPayAmount,&#xA;    TotalAmount,&#xA;    IsTotalCalculated,&#xA;    SharedRequestFlag,&#xA;    SharedMatchFlag,&#xA;    AccessARideFlag,&#xA;    WAVRequestFlag,&#xA;    WAVMatchFlag,&#xA;    IsCoreValid,&#xA;    QualityIssue&#xA;)&#xA;SELECT&#xA;    'FHVHV',&#xA;    HVFHSLicenseNum,&#xA;    DispatchingBaseNum,&#xA;    OriginatingBaseNum,&#xA;    RequestDT,&#xA;    OnSceneDT,&#xA;    PickupDT,&#xA;    DropoffDT,&#xA;    DurationSeconds,&#xA;    PULocationID,&#xA;    DOLocationID,&#xA;    TripDistance,&#xA;    FareAmount,&#xA;    TipAmount,&#xA;    TollsAmount,&#xA;    CongestionSurcharge,&#xA;    AirportFee,&#xA;    CBDCongestionFee,&#xA;    BCFAmount,&#xA;    SalesTaxAmount,&#xA;    DriverPayAmount,&#xA;    CalculatedTotal,&#xA;    1,&#xA;    SharedRequestFlag,&#xA;    SharedMatchFlag,&#xA;    AccessARideFlag,&#xA;    WAVRequestFlag,&#xA;    WAVMatchFlag,&#xA;    IsCoreValid,&#xA;    QualityIssue&#xA;FROM Q;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_Transform_Green"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D4853C5B-C483-4FE0-A539-A895D9D216BB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_Transform_Green"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF OBJECT_ID('clean.Trip', 'U') IS NULL&#xA;    THROW 50001, 'Chay 00_setup_clean.sql truoc.', 1;&#xA;&#xA;DELETE FROM clean.Trip&#xA;WHERE TaxiType = 'GREEN';&#xA;&#xA;;WITH S AS&#xA;(&#xA;    SELECT TOP (100000)&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(VendorID)), '')&#xA;        ) AS VendorID,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(lpep_pickup_datetime)), '')&#xA;        ) AS PickupDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(lpep_dropoff_datetime)), '')&#xA;        ) AS DropoffDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(PULocationID)), '')&#xA;        ) AS PULocationID,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(DOLocationID)), '')&#xA;        ) AS DOLocationID,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(passenger_count)), '')&#xA;        ) AS PassengerCount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(12,3),&#xA;            NULLIF(LTRIM(RTRIM(trip_distance)), '')&#xA;        ) AS TripDistance,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(RatecodeID)), '')&#xA;        ) AS RateCodeID,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(payment_type)), '')&#xA;        ) AS PaymentTypeID,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(trip_type)), '')&#xA;        ) AS TripTypeID,&#xA;&#xA;        UPPER(&#xA;            NULLIF(LTRIM(RTRIM(store_and_fwd_flag)), '')&#xA;        ) AS StoreAndFwdFlag,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(fare_amount)), '')&#xA;        ) AS FareAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(extra)), '')&#xA;        ) AS ExtraAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(mta_tax)), '')&#xA;        ) AS MTATax,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(tip_amount)), '')&#xA;        ) AS TipAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(tolls_amount)), '')&#xA;        ) AS TollsAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(improvement_surcharge)), '')&#xA;        ) AS ImprovementSurcharge,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(congestion_surcharge)), '')&#xA;        ) AS CongestionSurcharge,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(cbd_congestion_fee)), '')&#xA;        ) AS CBDCongestionFee,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(total_amount)), '')&#xA;        ) AS TotalAmount&#xA;    FROM stg.GreenTrip&#xA;),&#xA;T AS&#xA;(&#xA;    SELECT&#xA;        *,&#xA;        CASE&#xA;            WHEN PickupDT IS NULL&#xA;              OR DropoffDT IS NULL&#xA;              OR DropoffDT &lt;= PickupDT&#xA;              OR DATEDIFF_BIG(SECOND, PickupDT, DropoffDT) &gt; 172800&#xA;              OR TripDistance &lt; 0&#xA;            THEN CONVERT(BIT, 0)&#xA;            ELSE CONVERT(BIT, 1)&#xA;        END AS IsCoreValid,&#xA;&#xA;        NULLIF(&#xA;            CONCAT(&#xA;                CASE WHEN PickupDT IS NULL&#xA;                     THEN 'PICKUP_INVALID;' ELSE '' END,&#xA;&#xA;                CASE WHEN DropoffDT IS NULL&#xA;                     THEN 'DROPOFF_INVALID;' ELSE '' END,&#xA;&#xA;                CASE WHEN PickupDT IS NOT NULL&#xA;                           AND DropoffDT IS NOT NULL&#xA;                           AND DropoffDT &lt;= PickupDT&#xA;                     THEN 'DURATION_NON_POSITIVE;' ELSE '' END,&#xA;&#xA;                CASE WHEN PickupDT IS NOT NULL&#xA;                           AND DropoffDT IS NOT NULL&#xA;                           AND DATEDIFF_BIG(&#xA;                               SECOND,&#xA;                               PickupDT,&#xA;                               DropoffDT&#xA;                           ) &gt; 172800&#xA;                     THEN 'DURATION_OVER_48H;' ELSE '' END,&#xA;&#xA;                CASE WHEN TripDistance &lt; 0&#xA;                     THEN 'DISTANCE_NEGATIVE;' ELSE '' END,&#xA;&#xA;                CASE WHEN TotalAmount &lt; 0&#xA;                     THEN 'TOTAL_NEGATIVE;' ELSE '' END&#xA;            ),&#xA;            ''&#xA;        ) AS QualityIssue&#xA;    FROM S&#xA;)&#xA;INSERT INTO clean.Trip&#xA;(&#xA;    TaxiType,&#xA;    VendorID,&#xA;    PickupDateTime,&#xA;    DropoffDateTime,&#xA;    TripDurationSeconds,&#xA;    PULocationID,&#xA;    DOLocationID,&#xA;    PassengerCount,&#xA;    TripDistanceMiles,&#xA;    RateCodeID,&#xA;    PaymentTypeID,&#xA;    TripTypeID,&#xA;    StoreAndFwdFlag,&#xA;    FareAmount,&#xA;    ExtraAmount,&#xA;    MTATaxAmount,&#xA;    TipAmount,&#xA;    TollsAmount,&#xA;    ImprovementSurcharge,&#xA;    CongestionSurcharge,&#xA;    CBDCongestionFee,&#xA;    TotalAmount,&#xA;    IsTotalCalculated,&#xA;    IsCoreValid,&#xA;    QualityIssue&#xA;)&#xA;SELECT&#xA;    'GREEN',&#xA;    VendorID,&#xA;    PickupDT,&#xA;    DropoffDT,&#xA;    CASE&#xA;        WHEN PickupDT IS NOT NULL AND DropoffDT IS NOT NULL&#xA;        THEN DATEDIFF_BIG(SECOND, PickupDT, DropoffDT)&#xA;    END,&#xA;    PULocationID,&#xA;    DOLocationID,&#xA;    PassengerCount,&#xA;    TripDistance,&#xA;    RateCodeID,&#xA;    PaymentTypeID,&#xA;    TripTypeID,&#xA;    StoreAndFwdFlag,&#xA;    FareAmount,&#xA;    ExtraAmount,&#xA;    MTATax,&#xA;    TipAmount,&#xA;    TollsAmount,&#xA;    ImprovementSurcharge,&#xA;    CongestionSurcharge,&#xA;    CBDCongestionFee,&#xA;    TotalAmount,&#xA;    0,&#xA;    IsCoreValid,&#xA;    QualityIssue&#xA;FROM T;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_Transform_TaxiZone"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{15A7B376-32F9-4E2B-B74D-D63BC08BED7C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_Transform_TaxiZone"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF OBJECT_ID('clean.TaxiZone', 'U') IS NULL&#xA;    THROW 50001, 'Chay 00_setup_clean.sql truoc.', 1;&#xA;&#xA;DELETE FROM clean.TaxiZone;&#xA;&#xA;;WITH ZoneTyped AS&#xA;(&#xA;    SELECT&#xA;        TRY_CONVERT&#xA;        (&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(REPLACE(LocationID, '&quot;', ''))), '')&#xA;        ) AS LocationID,&#xA;&#xA;        NULLIF(&#xA;            LTRIM(RTRIM(REPLACE(Borough, '&quot;', ''))),&#xA;            ''&#xA;        ) AS Borough,&#xA;&#xA;        NULLIF(&#xA;            LTRIM(RTRIM(REPLACE(Zone, '&quot;', ''))),&#xA;            ''&#xA;        ) AS Zone,&#xA;&#xA;        NULLIF&#xA;        (&#xA;            LTRIM&#xA;            (&#xA;                RTRIM&#xA;                (&#xA;                    REPLACE(&#xA;                        REPLACE(service_zone, '&quot;', ''),&#xA;                        CHAR(13),&#xA;                        ''&#xA;                    )&#xA;                )&#xA;            ),&#xA;            ''&#xA;        ) AS ServiceZone&#xA;    FROM stg.TaxiZone&#xA;)&#xA;INSERT INTO clean.TaxiZone&#xA;(&#xA;    LocationID,&#xA;    Borough,&#xA;    Zone,&#xA;    ServiceZone&#xA;)&#xA;SELECT&#xA;    LocationID,&#xA;    MAX(Borough),&#xA;    MAX(Zone),&#xA;    MAX(ServiceZone)&#xA;FROM ZoneTyped&#xA;WHERE LocationID IS NOT NULL&#xA;GROUP BY LocationID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_Transform_Yellow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{06F5E0E5-EA61-4226-AE63-6CEBF95F9C38}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_Transform_Yellow"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF OBJECT_ID('clean.Trip', 'U') IS NULL&#xA;    THROW 50001, 'Chay 00_setup_clean.sql truoc.', 1;&#xA;&#xA;DELETE FROM clean.Trip&#xA;WHERE TaxiType = 'YELLOW';&#xA;&#xA;;WITH S AS&#xA;(&#xA;    SELECT TOP (100000)&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(VendorID)), '')&#xA;        ) AS VendorID,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(tpep_pickup_datetime)), '')&#xA;        ) AS PickupDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            DATETIME2(0),&#xA;            NULLIF(LTRIM(RTRIM(tpep_dropoff_datetime)), '')&#xA;        ) AS DropoffDT,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(PULocationID)), '')&#xA;        ) AS PULocationID,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(DOLocationID)), '')&#xA;        ) AS DOLocationID,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(passenger_count)), '')&#xA;        ) AS PassengerCount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(12,3),&#xA;            NULLIF(LTRIM(RTRIM(trip_distance)), '')&#xA;        ) AS TripDistance,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(RatecodeID)), '')&#xA;        ) AS RateCodeID,&#xA;&#xA;        TRY_CONVERT(&#xA;            INT,&#xA;            NULLIF(LTRIM(RTRIM(payment_type)), '')&#xA;        ) AS PaymentTypeID,&#xA;&#xA;        UPPER(&#xA;            NULLIF(LTRIM(RTRIM(store_and_fwd_flag)), '')&#xA;        ) AS StoreAndFwdFlag,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(fare_amount)), '')&#xA;        ) AS FareAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(extra)), '')&#xA;        ) AS ExtraAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(mta_tax)), '')&#xA;        ) AS MTATax,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(tip_amount)), '')&#xA;        ) AS TipAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(tolls_amount)), '')&#xA;        ) AS TollsAmount,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(improvement_surcharge)), '')&#xA;        ) AS ImprovementSurcharge,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(congestion_surcharge)), '')&#xA;        ) AS CongestionSurcharge,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(Airport_fee)), '')&#xA;        ) AS AirportFee,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(cbd_congestion_fee)), '')&#xA;        ) AS CBDCongestionFee,&#xA;&#xA;        TRY_CONVERT(&#xA;            DECIMAL(18,2),&#xA;            NULLIF(LTRIM(RTRIM(total_amount)), '')&#xA;        ) AS TotalAmount&#xA;    FROM stg.YellowTrip&#xA;),&#xA;T AS&#xA;(&#xA;    SELECT&#xA;        *,&#xA;        CASE&#xA;            WHEN PickupDT IS NULL&#xA;              OR DropoffDT IS NULL&#xA;              OR DropoffDT &lt;= PickupDT&#xA;              OR DATEDIFF_BIG(SECOND, PickupDT, DropoffDT) &gt; 172800&#xA;              OR TripDistance &lt; 0&#xA;            THEN CONVERT(BIT, 0)&#xA;            ELSE CONVERT(BIT, 1)&#xA;        END AS IsCoreValid,&#xA;&#xA;        NULLIF(&#xA;            CONCAT(&#xA;                CASE WHEN PickupDT IS NULL&#xA;                     THEN 'PICKUP_INVALID;' ELSE '' END,&#xA;&#xA;                CASE WHEN DropoffDT IS NULL&#xA;                     THEN 'DROPOFF_INVALID;' ELSE '' END,&#xA;&#xA;                CASE WHEN PickupDT IS NOT NULL&#xA;                           AND DropoffDT IS NOT NULL&#xA;                           AND DropoffDT &lt;= PickupDT&#xA;                     THEN 'DURATION_NON_POSITIVE;' ELSE '' END,&#xA;&#xA;                CASE WHEN PickupDT IS NOT NULL&#xA;                           AND DropoffDT IS NOT NULL&#xA;                           AND DATEDIFF_BIG(&#xA;                               SECOND,&#xA;                               PickupDT,&#xA;                               DropoffDT&#xA;                           ) &gt; 172800&#xA;                     THEN 'DURATION_OVER_48H;' ELSE '' END,&#xA;&#xA;                CASE WHEN TripDistance &lt; 0&#xA;                     THEN 'DISTANCE_NEGATIVE;' ELSE '' END,&#xA;&#xA;                CASE WHEN TotalAmount &lt; 0&#xA;                     THEN 'TOTAL_NEGATIVE;' ELSE '' END&#xA;            ),&#xA;            ''&#xA;        ) AS QualityIssue&#xA;    FROM S&#xA;)&#xA;INSERT INTO clean.Trip&#xA;(&#xA;    TaxiType,&#xA;    VendorID,&#xA;    PickupDateTime,&#xA;    DropoffDateTime,&#xA;    TripDurationSeconds,&#xA;    PULocationID,&#xA;    DOLocationID,&#xA;    PassengerCount,&#xA;    TripDistanceMiles,&#xA;    RateCodeID,&#xA;    PaymentTypeID,&#xA;    StoreAndFwdFlag,&#xA;    FareAmount,&#xA;    ExtraAmount,&#xA;    MTATaxAmount,&#xA;    TipAmount,&#xA;    TollsAmount,&#xA;    ImprovementSurcharge,&#xA;    CongestionSurcharge,&#xA;    AirportFee,&#xA;    CBDCongestionFee,&#xA;    TotalAmount,&#xA;    IsTotalCalculated,&#xA;    IsCoreValid,&#xA;    QualityIssue&#xA;)&#xA;SELECT&#xA;    'YELLOW',&#xA;    VendorID,&#xA;    PickupDT,&#xA;    DropoffDT,&#xA;    CASE&#xA;        WHEN PickupDT IS NOT NULL AND DropoffDT IS NOT NULL&#xA;        THEN DATEDIFF_BIG(SECOND, PickupDT, DropoffDT)&#xA;    END,&#xA;    PULocationID,&#xA;    DOLocationID,&#xA;    PassengerCount,&#xA;    TripDistance,&#xA;    RateCodeID,&#xA;    PaymentTypeID,&#xA;    StoreAndFwdFlag,&#xA;    FareAmount,&#xA;    ExtraAmount,&#xA;    MTATax,&#xA;    TipAmount,&#xA;    TollsAmount,&#xA;    ImprovementSurcharge,&#xA;    CongestionSurcharge,&#xA;    AirportFee,&#xA;    CBDCongestionFee,&#xA;    TotalAmount,&#xA;    0,&#xA;    IsCoreValid,&#xA;    QualityIssue&#xA;FROM T;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_Validate_Clean"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E92A1517-FD2B-40B3-A5BA-914507BE36CF}"
