      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Arguments">"\"" + @[$Package::pScriptsRoot] + "\\convert_nyc_parquet_to_csv.py\" --input \"" + @[$Package::pDataRoot] + "\\raw\" --output \"" + @[User::vCsvRoot] + "\" --start \"" + @[$Package::pStartMonth] + "\" --end \"" + @[$Package::pEndMonth] + "\" --max-rows " + (DT_WSTR,12)@[$Package::pMaxRows] + " --schema ssis --lookup"</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="Executable">@[$Package::pPythonExe]</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="WorkingDirectory">@[$Package::pScriptsRoot]</DTS:PropertyExpression>
      <DTS:ObjectData>
