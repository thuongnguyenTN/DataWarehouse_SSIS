<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="10/11/2026 6:28:41 PM"
  DTS:CreationName="Microsoft.Package"
  DTS:CreatorComputerName="THUONGNGUYEN"
  DTS:CreatorName="THUONGNGUYEN\ADMIN"
  DTS:DelayValidation="True"
  DTS:Description="Incremental Transform by source file; direct SQL; atomic clean and file log."
  DTS:DTSID="{073C3717-C076-4165-9405-C4439931995D}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="17.0.1016.0"
  DTS:LocaleID="1033"
  DTS:MaxConcurrentExecutables="1"
  DTS:ObjectName="PKG_02_Transform_Stage"
  DTS:PackageType="5"
  DTS:VersionBuild="4"
  DTS:VersionGUID="{9192D609-52C1-4913-9DA8-D8F405C2BCC0}">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\EST_01_Setup_Clean"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{6C81D90E-4D43-49AE-9C6A-644A5768F53B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_01_Setup_Clean"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;IF DB_NAME() &lt;&gt; 'NYCTaxi_Staging'&#xA;    THROW 51000, 'Chon connection NYCTaxi_Staging.', 1;&#xA;IF OBJECT_ID('stg.YellowTrip') IS NULL OR OBJECT_ID('stg.GreenTrip') IS NULL&#xA;    OR OBJECT_ID('stg.FHVTrip') IS NULL OR OBJECT_ID('stg.FHVHVTrip') IS NULL&#xA;    OR OBJECT_ID('stg.TaxiZone') IS NULL&#xA;    THROW 51001, 'Chay PKG_01 de tao va nap staging truoc.', 1;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'clean')&#xA;    EXEC('CREATE SCHEMA clean AUTHORIZATION dbo');&#xA;&#xA;/* ----------------------- 1. BANG CLEAN ----------------------- */&#xA;&#xA;IF OBJECT_ID('clean.TaxiZone', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE clean.TaxiZone&#xA;    (&#xA;        LocationID   INT           NOT NULL,&#xA;        Borough      NVARCHAR(100) NULL,&#xA;        Zone         NVARCHAR(200) NULL,&#xA;        ServiceZone  NVARCHAR(100) NULL,&#xA;        CONSTRAINT PK_CleanTaxiZone PRIMARY KEY (LocationID)&#xA;    );&#xA;END;&#xA;&#xA;IF OBJECT_ID('clean.Trip', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE clean.Trip&#xA;    (&#xA;        TripCleanID             BIGINT IDENTITY(1,1) NOT NULL,&#xA;        TaxiType                VARCHAR(10) NOT NULL,&#xA;&#xA;        VendorID                INT NULL,&#xA;        HVFHSLicenseNum         VARCHAR(30) NULL,&#xA;        DispatchingBaseNum      VARCHAR(30) NULL,&#xA;        OriginatingBaseNum      VARCHAR(30) NULL,&#xA;        AffiliatedBaseNum       VARCHAR(30) NULL,&#xA;&#xA;        RequestDateTime         DATETIME2(0) NULL,&#xA;        OnSceneDateTime         DATETIME2(0) NULL,&#xA;        PickupDateTime          DATETIME2(0) NULL,&#xA;        DropoffDateTime         DATETIME2(0) NULL,&#xA;        TripDurationSeconds     BIGINT NULL,&#xA;&#xA;        PULocationID            INT NULL,&#xA;        DOLocationID            INT NULL,&#xA;        PassengerCount          INT NULL,&#xA;        TripDistanceMiles       DECIMAL(12,3) NULL,&#xA;&#xA;        RateCodeID              INT NULL,&#xA;        PaymentTypeID           INT NULL,&#xA;        TripTypeID              INT NULL,&#xA;        StoreAndFwdFlag         VARCHAR(5) NULL,&#xA;&#xA;        FareAmount              DECIMAL(18,2) NULL,&#xA;        ExtraAmount             DECIMAL(18,2) NULL,&#xA;        MTATaxAmount            DECIMAL(18,2) NULL,&#xA;        TipAmount               DECIMAL(18,2) NULL,&#xA;        TollsAmount             DECIMAL(18,2) NULL,&#xA;        ImprovementSurcharge    DECIMAL(18,2) NULL,&#xA;        CongestionSurcharge     DECIMAL(18,2) NULL,&#xA;        AirportFee              DECIMAL(18,2) NULL,&#xA;        CBDCongestionFee        DECIMAL(18,2) NULL,&#xA;        BCFAmount               DECIMAL(18,2) NULL,&#xA;        SalesTaxAmount          DECIMAL(18,2) NULL,&#xA;        DriverPayAmount         DECIMAL(18,2) NULL,&#xA;        TotalAmount             DECIMAL(18,2) NULL,&#xA;        IsTotalCalculated       BIT NOT NULL,&#xA;&#xA;        SharedRequestFlag       VARCHAR(5) NULL,&#xA;        SharedMatchFlag         VARCHAR(5) NULL,&#xA;        AccessARideFlag         VARCHAR(5) NULL,&#xA;        WAVRequestFlag          VARCHAR(5) NULL,&#xA;        WAVMatchFlag            VARCHAR(5) NULL,&#xA;&#xA;        IsCoreValid             BIT NOT NULL,&#xA;        QualityIssue            VARCHAR(2000) NULL,&#xA;        CleanedAt               DATETIME2(0) NOT NULL&#xA;            CONSTRAINT DF_CleanTrip_CleanedAt DEFAULT SYSDATETIME(),&#xA;&#xA;        CONSTRAINT PK_CleanTrip PRIMARY KEY CLUSTERED (TripCleanID),&#xA;        CONSTRAINT CK_CleanTrip_TaxiType&#xA;            CHECK (TaxiType IN ('YELLOW', 'GREEN', 'FHV', 'FHVHV'))&#xA;    );&#xA;&#xA;    CREATE INDEX IX_CleanTrip_PickupDateTime&#xA;        ON clean.Trip (PickupDateTime, TaxiType);&#xA;&#xA;    CREATE INDEX IX_CleanTrip_Location&#xA;        ON clean.Trip (PULocationID, DOLocationID);&#xA;END;&#xA;&#xA;IF COL_LENGTH('clean.Trip', 'ETLSourceKey') IS NULL&#xA;    ALTER TABLE clean.Trip ADD [ETLSourceKey] NVARCHAR(260) NULL;&#xA;IF COL_LENGTH('clean.Trip', 'ETLFileHash') IS NULL&#xA;    ALTER TABLE clean.Trip ADD [ETLFileHash] CHAR(64) NULL;&#xA;IF COL_LENGTH('clean.Trip', 'ETLLoadedAt') IS NULL&#xA;    ALTER TABLE clean.Trip ADD [ETLLoadedAt] DATETIME2(0) NULL;&#xA;IF COL_LENGTH('clean.Trip', 'TripDistanceKm') IS NULL&#xA;    ALTER TABLE clean.Trip ADD [TripDistanceKm] DECIMAL(14,3) NULL;&#xA;IF COL_LENGTH('clean.Trip', 'AverageSpeedKmh') IS NULL&#xA;    ALTER TABLE clean.Trip ADD [AverageSpeedKmh] DECIMAL(14,3) NULL;&#xA;IF COL_LENGTH('clean.Trip', 'SourceTripDurationSeconds') IS NULL&#xA;    ALTER TABLE clean.Trip ADD [SourceTripDurationSeconds] BIGINT NULL;&#xA;IF COL_LENGTH('clean.Trip', 'RequestWaitSeconds') IS NULL&#xA;    ALTER TABLE clean.Trip ADD [RequestWaitSeconds] BIGINT NULL;&#xA;IF COL_LENGTH('clean.Trip', 'SourceSRFlag') IS NULL&#xA;    ALTER TABLE clean.Trip ADD [SourceSRFlag] VARCHAR(5) NULL;&#xA;IF COL_LENGTH('clean.Trip', 'EHailFeeAmount') IS NULL&#xA;    ALTER TABLE clean.Trip ADD [EHailFeeAmount] DECIMAL(18,2) NULL;&#xA;IF COL_LENGTH('clean.Trip', 'QualityIssue') &lt; 2000&#xA;    ALTER TABLE clean.Trip ALTER COLUMN QualityIssue VARCHAR(2000) NULL;&#xA;&#xA;/* Hai view nay duoc dung o buoc Load. */&#xA;EXEC('CREATE OR ALTER VIEW clean.ValidTrip AS&#xA;      SELECT * FROM clean.Trip WHERE IsCoreValid = 1;');&#xA;EXEC('CREATE OR ALTER VIEW clean.RejectedTrip AS&#xA;      SELECT * FROM clean.Trip WHERE IsCoreValid = 0;');&#xA;EXEC('CREATE OR ALTER VIEW clean.WarningTrip AS&#xA;      SELECT * FROM clean.Trip WHERE IsCoreValid = 1 AND QualityIssue IS NOT NULL;');&#xA;EXEC('CREATE OR ALTER VIEW clean.RevenueTrip AS&#xA;      SELECT * FROM clean.Trip WHERE IsCoreValid = 1 AND TotalAmount IS NOT NULL;');&#xA;EXEC('CREATE OR ALTER VIEW clean.TransformSummary AS&#xA;      SELECT TaxiType, COUNT_BIG(*) AS TotalRows,&#xA;          COUNT_BIG(CASE WHEN IsCoreValid=1 THEN 1 END) AS ValidRows,&#xA;          COUNT_BIG(CASE WHEN IsCoreValid=0 THEN 1 END) AS RejectedRows,&#xA;          COUNT_BIG(CASE WHEN IsCoreValid=1 AND QualityIssue IS NOT NULL THEN 1 END) AS WarningRows,&#xA;          COUNT_BIG(CASE WHEN IsCoreValid=1 AND TotalAmount IS NOT NULL THEN 1 END) AS RevenueAvailableRows&#xA;      FROM clean.Trip GROUP BY TaxiType;');&#xA;&#xA;&#xA;/* PKG_01 moi luu lineage cho tung tep. */&#xA;IF OBJECT_ID('etl.ExtractFileLog', 'U') IS NULL&#xA;    THROW 51200, 'Can etl.ExtractFileLog tu PKG_01 moi.', 1;&#xA;IF COL_LENGTH('stg.YellowTrip','ETLSourceKey') IS NULL&#xA;    OR COL_LENGTH('stg.GreenTrip','ETLSourceKey') IS NULL&#xA;    OR COL_LENGTH('stg.FHVTrip','ETLSourceKey') IS NULL&#xA;    OR COL_LENGTH('stg.FHVHVTrip','ETLSourceKey') IS NULL&#xA;    OR COL_LENGTH('stg.TaxiZone','ETLSourceKey') IS NULL&#xA;    THROW 51201, 'Staging thieu ETLSourceKey. Dung PKG_01 moi de nap staging.', 1;&#xA;&#xA;/* Dung lai dung cau truc log da tao o ban Transform truoc. */&#xA;IF OBJECT_ID('etl.TransformFileLog', 'U') IS NULL&#xA;    CREATE TABLE etl.TransformFileLog&#xA;    (&#xA;        DatasetCode VARCHAR(20) NOT NULL,&#xA;        SourceKey NVARCHAR(260) NOT NULL,&#xA;        FileHash CHAR(64) NOT NULL,&#xA;        RuleVersion VARCHAR(64) NOT NULL,&#xA;        ZoneHash CHAR(64) NOT NULL,&#xA;        SourceRows BIGINT NOT NULL,&#xA;        CleanRows BIGINT NOT NULL,&#xA;        ValidRows BIGINT NOT NULL,&#xA;        RejectedRows BIGINT NOT NULL,&#xA;        WarningRows BIGINT NOT NULL,&#xA;        CompletedAt DATETIME2(0) NOT NULL,&#xA;        CONSTRAINT PK_TransformFileLog PRIMARY KEY(DatasetCode,SourceKey),&#xA;        CONSTRAINT CK_TransformFileLog_Counts CHECK&#xA;            (SourceRows=CleanRows AND CleanRows=ValidRows+RejectedRows)&#xA;    );&#xA;&#xA;IF COL_LENGTH('etl.TransformFileLog','RuleVersion') IS NULL&#xA;    OR COL_LENGTH('etl.TransformFileLog','ZoneHash') IS NULL&#xA;    OR COL_LENGTH('etl.TransformFileLog','SourceRows') IS NULL&#xA;    OR COL_LENGTH('etl.TransformFileLog','CleanRows') IS NULL&#xA;    THROW 51202, 'Cau truc etl.TransformFileLog cu khong tuong thich.', 1;&#xA;&#xA;/* Dem/tra cuu theo tep bang index gon, tranh doc cac cot do luong cu. */&#xA;IF NOT EXISTS(SELECT 1 FROM sys.indexes&#xA;    WHERE object_id=OBJECT_ID('clean.Trip') AND name='IX_CleanTrip_Source')&#xA;    EXEC('CREATE INDEX IX_CleanTrip_Source ON clean.Trip(TaxiType,ETLSourceKey)&#xA;          INCLUDE(ETLFileHash);');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_02_Transform_TaxiZone"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{86168B05-8CBC-4E7A-A6BF-C04DCF62839D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_02_Transform_TaxiZone"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @FileHash CHAR(64), @ExpectedRows BIGINT, @CleanRows BIGINT,&#xA;        @ZoneText NVARCHAR(MAX), @ZoneHash CHAR(64), @Processed INT=0;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    SELECT @FileHash=FileHash, @ExpectedRows=ExpectedRows&#xA;    FROM etl.ExtractFileLog WITH(UPDLOCK,HOLDLOCK)&#xA;    WHERE DatasetCode='lookup' AND SourceKey='taxi_zone_lookup.csv'&#xA;        AND LoadStatus='SUCCEEDED' AND RowsLoaded=ExpectedRows;&#xA;    IF @ExpectedRows IS NULL OR @ExpectedRows=0&#xA;        THROW 51210, 'Extract lookup chua hoan tat.', 1;&#xA;&#xA;    SELECT @CleanRows=COUNT_BIG(*) FROM clean.TaxiZone WITH(HOLDLOCK);&#xA;SELECT @ZoneText=CONVERT(NVARCHAR(MAX),&#xA;    (SELECT LocationID,Borough,Zone,ServiceZone&#xA;     FROM clean.TaxiZone WITH(HOLDLOCK)&#xA;     ORDER BY LocationID FOR XML RAW('z'),TYPE));&#xA;SET @ZoneHash=CONVERT(CHAR(64),HASHBYTES('SHA2_256',@ZoneText),2);&#xA;&#xA;    IF NOT EXISTS(SELECT 1 FROM etl.TransformFileLog WITH(UPDLOCK,HOLDLOCK)&#xA;        WHERE DatasetCode='lookup' AND SourceKey='taxi_zone_lookup.csv'&#xA;            AND FileHash=@FileHash AND SourceRows=@ExpectedRows&#xA;            AND CleanRows=@CleanRows AND CleanRows=@ExpectedRows&#xA;            AND RuleVersion='INCR_ZONE_20261019_1' AND ZoneHash=@ZoneHash)&#xA;    BEGIN&#xA;        /* Chi doc staging lookup neu can xu ly lai. */&#xA;        IF (SELECT COUNT_BIG(*) FROM stg.TaxiZone WITH(HOLDLOCK))&lt;&gt;@ExpectedRows&#xA;            OR EXISTS(SELECT 1 FROM stg.TaxiZone WITH(HOLDLOCK)&#xA;                WHERE ETLSourceKey IS NULL OR ETLSourceKey&lt;&gt;'taxi_zone_lookup.csv'&#xA;                    OR ETLFileHash IS NULL OR ETLFileHash&lt;&gt;@FileHash)&#xA;            THROW 51211, 'Staging lookup khong khop log Extract. Chay lai PKG_01.', 1;&#xA;&#xA;DELETE FROM clean.TaxiZone;&#xA;&#xA;;WITH Z AS&#xA;(&#xA;    SELECT&#xA;        TRY_CONVERT(INT, NULLIF(LTRIM(RTRIM(LocationID)), '')) AS LocationID,&#xA;        NULLIF(LTRIM(RTRIM(Borough)), '') AS Borough,&#xA;        NULLIF(LTRIM(RTRIM(Zone)), '') AS Zone,&#xA;        NULLIF(LTRIM(RTRIM(REPLACE(service_zone, CHAR(13), ''))), '') AS ServiceZone&#xA;    FROM stg.TaxiZone&#xA;), R AS&#xA;(&#xA;    SELECT *, ROW_NUMBER() OVER&#xA;        (PARTITION BY LocationID ORDER BY Borough, Zone, ServiceZone) AS RowNum&#xA;    FROM Z&#xA;    WHERE LocationID &gt; 0 AND Zone IS NOT NULL&#xA;)&#xA;INSERT INTO clean.TaxiZone(LocationID, Borough, Zone, ServiceZone)&#xA;SELECT LocationID, Borough, Zone, ServiceZone&#xA;FROM R&#xA;WHERE RowNum = 1;&#xA;&#xA;IF NOT EXISTS(SELECT 1 FROM clean.TaxiZone)&#xA;    THROW 51004, 'Khong co TaxiZone hop le; rollback lookup.', 1;&#xA;&#xA;&#xA;&#xA;        SELECT @CleanRows=COUNT_BIG(*) FROM clean.TaxiZone;&#xA;        IF @CleanRows&lt;&gt;@ExpectedRows&#xA;            THROW 51212, 'Lookup co ID loi/trung. Giu lookup cu va kiem tra staging.', 1;&#xA;SELECT @ZoneText=CONVERT(NVARCHAR(MAX),&#xA;    (SELECT LocationID,Borough,Zone,ServiceZone&#xA;     FROM clean.TaxiZone WITH(HOLDLOCK)&#xA;     ORDER BY LocationID FOR XML RAW('z'),TYPE));&#xA;SET @ZoneHash=CONVERT(CHAR(64),HASHBYTES('SHA2_256',@ZoneText),2);&#xA;        DELETE FROM etl.TransformFileLog&#xA;        WHERE DatasetCode='lookup' AND SourceKey='taxi_zone_lookup.csv';&#xA;        INSERT etl.TransformFileLog&#xA;            (DatasetCode,SourceKey,FileHash,RuleVersion,ZoneHash,SourceRows,&#xA;             CleanRows,ValidRows,RejectedRows,WarningRows,CompletedAt)&#xA;        VALUES('lookup','taxi_zone_lookup.csv',@FileHash,'INCR_ZONE_20261019_1',@ZoneHash,&#xA;            @ExpectedRows,@CleanRows,@CleanRows,0,0,SYSDATETIME());&#xA;        SET @Processed=1;&#xA;    END;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT&gt;0 ROLLBACK TRANSACTION;&#xA;    THROW;&#xA;END CATCH;&#xA;SELECT 'lookup' AS DatasetCode,@Processed AS ProcessedFiles,1-@Processed AS SkippedFiles;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_03_Transform_YELLOW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{722EE182-A2FF-445F-A173-3E813B677176}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_03_Transform_YELLOW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @Dataset VARCHAR(20)='yellow', @TaxiType VARCHAR(10)='YELLOW',&#xA;        @RuleVersion VARCHAR(64)='INCR_20261019_1|hours=48', @MaxDurationHours INT=48,&#xA;        @ZoneText NVARCHAR(MAX), @ZoneHash CHAR(64);&#xA;&#xA;DROP TABLE IF EXISTS #Files;&#xA;DROP TABLE IF EXISTS #CleanCounts;&#xA;DROP TABLE IF EXISTS #Todo;&#xA;DROP TABLE IF EXISTS #StageCounts;&#xA;DROP TABLE IF EXISTS #Result;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;    IF NOT EXISTS(SELECT 1 FROM clean.TaxiZone WITH(HOLDLOCK))&#xA;        THROW 51220, 'Chay task lookup truoc.', 1;&#xA;    IF EXISTS(SELECT 1 FROM clean.Trip WITH(UPDLOCK,HOLDLOCK)&#xA;        WHERE TaxiType=@TaxiType AND ETLSourceKey IS NULL)&#xA;        THROW 51221, 'Clean cu thieu ETLSourceKey; can chuan hoa lineage truoc.', 1;&#xA;    IF EXISTS(SELECT 1 FROM stg.YellowTrip WITH(HOLDLOCK) WHERE ETLSourceKey IS NULL)&#xA;        THROW 51222, 'Staging thieu lineage. Dung PKG_01 moi.', 1;&#xA;&#xA;SELECT @ZoneText=CONVERT(NVARCHAR(MAX),&#xA;    (SELECT LocationID,Borough,Zone,ServiceZone&#xA;     FROM clean.TaxiZone WITH(HOLDLOCK)&#xA;     ORDER BY LocationID FOR XML RAW('z'),TYPE));&#xA;SET @ZoneHash=CONVERT(CHAR(64),HASHBYTES('SHA2_256',@ZoneText),2);&#xA;&#xA;    /* 1. Cac tep Extract da nap thanh cong. Khong chuyen kieu du lieu o buoc nay. */&#xA;    SELECT SourceKey,FileHash,ExpectedRows&#xA;    INTO #Files&#xA;    FROM etl.ExtractFileLog WITH(UPDLOCK,HOLDLOCK)&#xA;    WHERE DatasetCode=@Dataset AND LoadStatus='SUCCEEDED' AND RowsLoaded=ExpectedRows;&#xA;&#xA;    /* 2. Kiem tra so dong/hash clean thuc te bang index theo tep. */&#xA;    SELECT t.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS CleanRows,&#xA;        COUNT_BIG(CASE WHEN t.ETLFileHash IS NULL OR t.ETLFileHash&lt;&gt;f.FileHash THEN 1 END) AS BadHashRows&#xA;    INTO #CleanCounts&#xA;    FROM clean.Trip AS t WITH(HOLDLOCK)&#xA;    INNER JOIN #Files AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType&#xA;    GROUP BY t.ETLSourceKey;&#xA;&#xA;    /* 3. Chi chon tep chua lam, tep thay doi, hoac clean bi thieu. */&#xA;SELECT f.SourceKey,f.FileHash,f.ExpectedRows&#xA;INTO #Todo&#xA;FROM #Files AS f&#xA;LEFT JOIN #CleanCounts AS c ON c.SourceKey=f.SourceKey&#xA;LEFT JOIN etl.TransformFileLog AS l WITH(UPDLOCK,HOLDLOCK)&#xA;    ON l.DatasetCode=@Dataset AND l.SourceKey=f.SourceKey&#xA;WHERE l.SourceKey IS NULL&#xA;    OR l.FileHash&lt;&gt;f.FileHash&#xA;    OR l.SourceRows&lt;&gt;f.ExpectedRows OR l.CleanRows&lt;&gt;f.ExpectedRows&#xA;    OR l.RuleVersion&lt;&gt;@RuleVersion OR l.ZoneHash&lt;&gt;@ZoneHash&#xA;    OR COALESCE(c.CleanRows,0)&lt;&gt;f.ExpectedRows&#xA;    OR COALESCE(c.BadHashRows,0)&gt;0;&#xA;    CREATE UNIQUE CLUSTERED INDEX IX_Todo_Source ON #Todo(SourceKey);&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo)&#xA;    BEGIN&#xA;    /* 4. Kiem tra staging cua DUNG cac tep can xu ly truoc khi sua clean. */&#xA;    SELECT s.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS SourceRows,&#xA;        COUNT_BIG(CASE WHEN s.ETLFileHash IS NULL OR s.ETLFileHash&lt;&gt;f.FileHash THEN 1 END) AS BadHashRows&#xA;    INTO #StageCounts&#xA;    FROM stg.YellowTrip AS s WITH(HOLDLOCK)&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=s.ETLSourceKey&#xA;    GROUP BY s.ETLSourceKey;&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo AS f LEFT JOIN #StageCounts AS s ON s.SourceKey=f.SourceKey&#xA;        WHERE COALESCE(s.SourceRows,0)&lt;&gt;f.ExpectedRows OR COALESCE(s.BadHashRows,0)&gt;0)&#xA;        THROW 51223, 'Staging cua tep can Transform khong khop log. Chay lai PKG_01.', 1;&#xA;&#xA;    /* 5. Giu nguyen cac tep da hoan tat; chi thay the cac tep trong #Todo. */&#xA;    DELETE t FROM clean.Trip AS t&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType;&#xA;&#xA;;WITH S AS&#xA;(&#xA;    SELECT&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([tpep_pickup_datetime])), '')) AS PickupDateTime,&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([tpep_dropoff_datetime])), '')) AS DropoffDateTime,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([PULocationID])), '')) AS PULocationID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([DOLocationID])), '')) AS DOLocationID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([VendorID])), '')) AS VendorID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([passenger_count])), '')) AS PassengerCount,&#xA;        TRY_CONVERT(DECIMAL(12,3), NULLIF(LTRIM(RTRIM([trip_distance])), '')) AS TripDistanceMiles,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([RatecodeID])), '')) AS RateCodeID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([payment_type])), '')) AS PaymentTypeID,&#xA;        CASE WHEN UPPER(NULLIF(LTRIM(RTRIM([store_and_fwd_flag])), '')) IN ('Y','1','TRUE') THEN 'Y' WHEN UPPER(NULLIF(LTRIM(RTRIM([store_and_fwd_flag])), '')) IN ('N','0','FALSE') THEN 'N' END AS StoreAndFwdFlag,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([fare_amount])), '')) AS FareAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([extra])), '')) AS ExtraAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([mta_tax])), '')) AS MTATaxAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([tip_amount])), '')) AS TipAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([tolls_amount])), '')) AS TollsAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([improvement_surcharge])), '')) AS ImprovementSurcharge,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([congestion_surcharge])), '')) AS CongestionSurcharge,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([cbd_congestion_fee])), '')) AS CBDCongestionFee,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([total_amount])), '')) AS TotalAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([Airport_fee])), '')) AS AirportFee,&#xA;        ETLSourceKey,&#xA;        ETLFileHash,&#xA;        ETLLoadedAt&#xA;    FROM stg.YellowTrip AS s WITH(HOLDLOCK)&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=s.ETLSourceKey&#xA;)&#xA;INSERT INTO clean.Trip&#xA;(&#xA;    TaxiType, PickupDateTime, DropoffDateTime, PULocationID, DOLocationID, VendorID, PassengerCount, TripDistanceMiles, RateCodeID, PaymentTypeID, StoreAndFwdFlag, FareAmount, ExtraAmount, MTATaxAmount, TipAmount, TollsAmount, ImprovementSurcharge, CongestionSurcharge, CBDCongestionFee, TotalAmount, AirportFee, TripDurationSeconds, IsTotalCalculated, IsCoreValid, ETLSourceKey, ETLFileHash, ETLLoadedAt&#xA;)&#xA;SELECT&#xA;    'YELLOW',&#xA;    PickupDateTime,&#xA;    DropoffDateTime,&#xA;    CASE WHEN PULocationID = FLOOR(PULocationID) THEN TRY_CONVERT(INT, PULocationID) END,&#xA;    CASE WHEN DOLocationID = FLOOR(DOLocationID) THEN TRY_CONVERT(INT, DOLocationID) END,&#xA;    CASE WHEN VendorID = FLOOR(VendorID) THEN TRY_CONVERT(INT, VendorID) END,&#xA;    CASE WHEN PassengerCount = FLOOR(PassengerCount) THEN TRY_CONVERT(INT, PassengerCount) END,&#xA;    TripDistanceMiles,&#xA;    CASE WHEN RateCodeID = FLOOR(RateCodeID) THEN TRY_CONVERT(INT, RateCodeID) END,&#xA;    CASE WHEN PaymentTypeID = FLOOR(PaymentTypeID) THEN TRY_CONVERT(INT, PaymentTypeID) END,&#xA;    StoreAndFwdFlag,&#xA;    FareAmount,&#xA;    ExtraAmount,&#xA;    MTATaxAmount,&#xA;    TipAmount,&#xA;    TollsAmount,&#xA;    ImprovementSurcharge,&#xA;    CongestionSurcharge,&#xA;    CBDCongestionFee,&#xA;    TotalAmount,&#xA;    AirportFee,&#xA;    DATEDIFF_BIG(SECOND, PickupDateTime, DropoffDateTime),&#xA;    0,&#xA;    0,&#xA;    ETLSourceKey,&#xA;    ETLFileHash,&#xA;    ETLLoadedAt&#xA;FROM S;&#xA;&#xA;    /* 6. Chi tinh do do/gan loi cho cac tep vua nap. */&#xA;UPDATE t&#xA;SET&#xA;    TripDistanceKm = TRY_CONVERT(DECIMAL(14,3), t.TripDistanceMiles * 1.609344),&#xA;    AverageSpeedKmh = CASE WHEN t.TripDurationSeconds &gt; 0 AND t.TripDistanceMiles &gt;= 0&#xA;        THEN TRY_CONVERT(DECIMAL(14,3), t.TripDistanceMiles * 1.609344 * 3600.0&#xA;            / NULLIF(t.TripDurationSeconds, 0)) END,&#xA;    RequestWaitSeconds = CASE WHEN t.RequestDateTime &lt;= t.PickupDateTime&#xA;        THEN DATEDIFF_BIG(SECOND, t.RequestDateTime, t.PickupDateTime) END,&#xA;    IsCoreValid = CASE&#xA;        WHEN t.PickupDateTime IS NULL OR t.DropoffDateTime IS NULL&#xA;          OR t.DropoffDateTime &lt;= t.PickupDateTime&#xA;          OR t.TripDurationSeconds &gt; CONVERT(BIGINT, @MaxDurationHours) * 3600&#xA;          OR (t.TaxiType &lt;&gt; 'FHV' AND (t.TripDistanceMiles IS NULL OR t.TripDistanceMiles &lt; 0))&#xA;        THEN 0 ELSE 1 END,&#xA;    QualityIssue = NULLIF(CONCAT(&#xA;        CASE WHEN t.PickupDateTime IS NULL THEN 'PICKUP_INVALID;' ELSE '' END,&#xA;        CASE WHEN t.DropoffDateTime IS NULL THEN 'DROPOFF_INVALID;' ELSE '' END,&#xA;        CASE WHEN t.DropoffDateTime &lt;= t.PickupDateTime THEN 'DURATION_NON_POSITIVE;' ELSE '' END,&#xA;        CASE WHEN t.TripDurationSeconds &gt; CONVERT(BIGINT, @MaxDurationHours) * 3600 THEN 'DURATION_OVER_LIMIT;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType &lt;&gt; 'FHV' AND t.TripDistanceMiles IS NULL THEN 'DISTANCE_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.TripDistanceMiles &lt; 0 THEN 'DISTANCE_NEGATIVE;' ELSE '' END,&#xA;        CASE WHEN t.TripDistanceMiles = 0 THEN 'DISTANCE_ZERO;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType IN ('YELLOW','GREEN') AND (t.PassengerCount IS NULL OR t.PassengerCount &lt;= 0) THEN 'PASSENGER_INVALID;' ELSE '' END,&#xA;        CASE WHEN pu.LocationID IS NULL THEN 'PU_LOCATION_UNKNOWN;' ELSE '' END,&#xA;        CASE WHEN dz.LocationID IS NULL THEN 'DO_LOCATION_UNKNOWN;' ELSE '' END,&#xA;        CASE WHEN t.TotalAmount &lt; 0 THEN 'TOTAL_NEGATIVE;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType &lt;&gt; 'FHV' AND t.TotalAmount IS NULL THEN 'TOTAL_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType = 'FHVHV' AND t.RequestDateTime IS NULL THEN 'REQUEST_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.RequestDateTime &gt; t.PickupDateTime THEN 'REQUEST_AFTER_PICKUP;' ELSE '' END,&#xA;        CASE WHEN t.OnSceneDateTime &gt; t.PickupDateTime THEN 'ONSCENE_AFTER_PICKUP;' ELSE '' END,&#xA;        CASE WHEN ABS(CONVERT(DECIMAL(38,0), t.SourceTripDurationSeconds) - t.TripDurationSeconds) &gt; 60&#xA;            THEN 'SOURCE_DURATION_MISMATCH;' ELSE '' END&#xA;    ), '')&#xA;FROM clean.Trip AS t&#xA;INNER JOIN #Todo AS scope ON scope.SourceKey=t.ETLSourceKey&#xA;LEFT JOIN clean.TaxiZone AS pu ON pu.LocationID = t.PULocationID&#xA;LEFT JOIN clean.TaxiZone AS dz ON dz.LocationID = t.DOLocationID&#xA;WHERE t.TaxiType=@TaxiType;&#xA;&#xA;    /* 7. Doi soat va ghi log trong CUNG transaction voi du lieu clean. */&#xA;    SELECT t.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS CleanRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=1 THEN 1 END) AS ValidRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=0 THEN 1 END) AS RejectedRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=1 AND t.QualityIssue IS NOT NULL THEN 1 END) AS WarningRows&#xA;    INTO #Result&#xA;    FROM clean.Trip AS t&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType&#xA;    GROUP BY t.ETLSourceKey;&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo AS f LEFT JOIN #Result AS r ON r.SourceKey=f.SourceKey&#xA;        WHERE COALESCE(r.CleanRows,0)&lt;&gt;f.ExpectedRows&#xA;            OR COALESCE(r.ValidRows,0)+COALESCE(r.RejectedRows,0)&lt;&gt;f.ExpectedRows)&#xA;        THROW 51224, 'So dong sau Transform khong khop. Rollback tep dang xu ly.', 1;&#xA;&#xA;    DELETE l FROM etl.TransformFileLog AS l&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=l.SourceKey&#xA;    WHERE l.DatasetCode=@Dataset;&#xA;&#xA;    INSERT etl.TransformFileLog&#xA;        (DatasetCode,SourceKey,FileHash,RuleVersion,ZoneHash,SourceRows,&#xA;         CleanRows,ValidRows,RejectedRows,WarningRows,CompletedAt)&#xA;    SELECT @Dataset,f.SourceKey,f.FileHash,@RuleVersion,@ZoneHash,f.ExpectedRows,&#xA;        COALESCE(r.CleanRows,0),COALESCE(r.ValidRows,0),COALESCE(r.RejectedRows,0),&#xA;        COALESCE(r.WarningRows,0),SYSDATETIME()&#xA;    FROM #Todo AS f LEFT JOIN #Result AS r ON r.SourceKey=f.SourceKey;&#xA;    END;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT&gt;0 ROLLBACK TRANSACTION;&#xA;    THROW;&#xA;END CATCH;&#xA;&#xA;SELECT @Dataset AS DatasetCode,&#xA;    (SELECT COUNT(*) FROM #Todo) AS ProcessedFiles,&#xA;    (SELECT COUNT(*) FROM #Files)-(SELECT COUNT(*) FROM #Todo) AS SkippedFiles;&#xA;&#xA;DROP TABLE IF EXISTS #Files;&#xA;DROP TABLE IF EXISTS #CleanCounts;&#xA;DROP TABLE IF EXISTS #Todo;&#xA;DROP TABLE IF EXISTS #StageCounts;&#xA;DROP TABLE IF EXISTS #Result;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_04_Transform_GREEN"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{3406E1DF-8247-4AE8-A642-1EB3FD58BA7C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_04_Transform_GREEN"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @Dataset VARCHAR(20)='green', @TaxiType VARCHAR(10)='GREEN',&#xA;        @RuleVersion VARCHAR(64)='INCR_20261019_1|hours=48', @MaxDurationHours INT=48,&#xA;        @ZoneText NVARCHAR(MAX), @ZoneHash CHAR(64);&#xA;&#xA;DROP TABLE IF EXISTS #Files;&#xA;DROP TABLE IF EXISTS #CleanCounts;&#xA;DROP TABLE IF EXISTS #Todo;&#xA;DROP TABLE IF EXISTS #StageCounts;&#xA;DROP TABLE IF EXISTS #Result;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;    IF NOT EXISTS(SELECT 1 FROM clean.TaxiZone WITH(HOLDLOCK))&#xA;        THROW 51220, 'Chay task lookup truoc.', 1;&#xA;    IF EXISTS(SELECT 1 FROM clean.Trip WITH(UPDLOCK,HOLDLOCK)&#xA;        WHERE TaxiType=@TaxiType AND ETLSourceKey IS NULL)&#xA;        THROW 51221, 'Clean cu thieu ETLSourceKey; can chuan hoa lineage truoc.', 1;&#xA;    IF EXISTS(SELECT 1 FROM stg.GreenTrip WITH(HOLDLOCK) WHERE ETLSourceKey IS NULL)&#xA;        THROW 51222, 'Staging thieu lineage. Dung PKG_01 moi.', 1;&#xA;&#xA;SELECT @ZoneText=CONVERT(NVARCHAR(MAX),&#xA;    (SELECT LocationID,Borough,Zone,ServiceZone&#xA;     FROM clean.TaxiZone WITH(HOLDLOCK)&#xA;     ORDER BY LocationID FOR XML RAW('z'),TYPE));&#xA;SET @ZoneHash=CONVERT(CHAR(64),HASHBYTES('SHA2_256',@ZoneText),2);&#xA;&#xA;    /* 1. Cac tep Extract da nap thanh cong. Khong chuyen kieu du lieu o buoc nay. */&#xA;    SELECT SourceKey,FileHash,ExpectedRows&#xA;    INTO #Files&#xA;    FROM etl.ExtractFileLog WITH(UPDLOCK,HOLDLOCK)&#xA;    WHERE DatasetCode=@Dataset AND LoadStatus='SUCCEEDED' AND RowsLoaded=ExpectedRows;&#xA;&#xA;    /* 2. Kiem tra so dong/hash clean thuc te bang index theo tep. */&#xA;    SELECT t.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS CleanRows,&#xA;        COUNT_BIG(CASE WHEN t.ETLFileHash IS NULL OR t.ETLFileHash&lt;&gt;f.FileHash THEN 1 END) AS BadHashRows&#xA;    INTO #CleanCounts&#xA;    FROM clean.Trip AS t WITH(HOLDLOCK)&#xA;    INNER JOIN #Files AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType&#xA;    GROUP BY t.ETLSourceKey;&#xA;&#xA;    /* 3. Chi chon tep chua lam, tep thay doi, hoac clean bi thieu. */&#xA;SELECT f.SourceKey,f.FileHash,f.ExpectedRows&#xA;INTO #Todo&#xA;FROM #Files AS f&#xA;LEFT JOIN #CleanCounts AS c ON c.SourceKey=f.SourceKey&#xA;LEFT JOIN etl.TransformFileLog AS l WITH(UPDLOCK,HOLDLOCK)&#xA;    ON l.DatasetCode=@Dataset AND l.SourceKey=f.SourceKey&#xA;WHERE l.SourceKey IS NULL&#xA;    OR l.FileHash&lt;&gt;f.FileHash&#xA;    OR l.SourceRows&lt;&gt;f.ExpectedRows OR l.CleanRows&lt;&gt;f.ExpectedRows&#xA;    OR l.RuleVersion&lt;&gt;@RuleVersion OR l.ZoneHash&lt;&gt;@ZoneHash&#xA;    OR COALESCE(c.CleanRows,0)&lt;&gt;f.ExpectedRows&#xA;    OR COALESCE(c.BadHashRows,0)&gt;0;&#xA;    CREATE UNIQUE CLUSTERED INDEX IX_Todo_Source ON #Todo(SourceKey);&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo)&#xA;    BEGIN&#xA;    /* 4. Kiem tra staging cua DUNG cac tep can xu ly truoc khi sua clean. */&#xA;    SELECT s.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS SourceRows,&#xA;        COUNT_BIG(CASE WHEN s.ETLFileHash IS NULL OR s.ETLFileHash&lt;&gt;f.FileHash THEN 1 END) AS BadHashRows&#xA;    INTO #StageCounts&#xA;    FROM stg.GreenTrip AS s WITH(HOLDLOCK)&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=s.ETLSourceKey&#xA;    GROUP BY s.ETLSourceKey;&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo AS f LEFT JOIN #StageCounts AS s ON s.SourceKey=f.SourceKey&#xA;        WHERE COALESCE(s.SourceRows,0)&lt;&gt;f.ExpectedRows OR COALESCE(s.BadHashRows,0)&gt;0)&#xA;        THROW 51223, 'Staging cua tep can Transform khong khop log. Chay lai PKG_01.', 1;&#xA;&#xA;    /* 5. Giu nguyen cac tep da hoan tat; chi thay the cac tep trong #Todo. */&#xA;    DELETE t FROM clean.Trip AS t&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType;&#xA;&#xA;;WITH S AS&#xA;(&#xA;    SELECT&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([lpep_pickup_datetime])), '')) AS PickupDateTime,&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([lpep_dropoff_datetime])), '')) AS DropoffDateTime,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([PULocationID])), '')) AS PULocationID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([DOLocationID])), '')) AS DOLocationID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([VendorID])), '')) AS VendorID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([passenger_count])), '')) AS PassengerCount,&#xA;        TRY_CONVERT(DECIMAL(12,3), NULLIF(LTRIM(RTRIM([trip_distance])), '')) AS TripDistanceMiles,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([RatecodeID])), '')) AS RateCodeID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([payment_type])), '')) AS PaymentTypeID,&#xA;        CASE WHEN UPPER(NULLIF(LTRIM(RTRIM([store_and_fwd_flag])), '')) IN ('Y','1','TRUE') THEN 'Y' WHEN UPPER(NULLIF(LTRIM(RTRIM([store_and_fwd_flag])), '')) IN ('N','0','FALSE') THEN 'N' END AS StoreAndFwdFlag,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([fare_amount])), '')) AS FareAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([extra])), '')) AS ExtraAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([mta_tax])), '')) AS MTATaxAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([tip_amount])), '')) AS TipAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([tolls_amount])), '')) AS TollsAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([improvement_surcharge])), '')) AS ImprovementSurcharge,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([congestion_surcharge])), '')) AS CongestionSurcharge,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([cbd_congestion_fee])), '')) AS CBDCongestionFee,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([total_amount])), '')) AS TotalAmount,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([trip_type])), '')) AS TripTypeID,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([ehail_fee])), '')) AS EHailFeeAmount,&#xA;        ETLSourceKey,&#xA;        ETLFileHash,&#xA;        ETLLoadedAt&#xA;    FROM stg.GreenTrip AS s WITH(HOLDLOCK)&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=s.ETLSourceKey&#xA;)&#xA;INSERT INTO clean.Trip&#xA;(&#xA;    TaxiType, PickupDateTime, DropoffDateTime, PULocationID, DOLocationID, VendorID, PassengerCount, TripDistanceMiles, RateCodeID, PaymentTypeID, StoreAndFwdFlag, FareAmount, ExtraAmount, MTATaxAmount, TipAmount, TollsAmount, ImprovementSurcharge, CongestionSurcharge, CBDCongestionFee, TotalAmount, TripTypeID, EHailFeeAmount, TripDurationSeconds, IsTotalCalculated, IsCoreValid, ETLSourceKey, ETLFileHash, ETLLoadedAt&#xA;)&#xA;SELECT&#xA;    'GREEN',&#xA;    PickupDateTime,&#xA;    DropoffDateTime,&#xA;    CASE WHEN PULocationID = FLOOR(PULocationID) THEN TRY_CONVERT(INT, PULocationID) END,&#xA;    CASE WHEN DOLocationID = FLOOR(DOLocationID) THEN TRY_CONVERT(INT, DOLocationID) END,&#xA;    CASE WHEN VendorID = FLOOR(VendorID) THEN TRY_CONVERT(INT, VendorID) END,&#xA;    CASE WHEN PassengerCount = FLOOR(PassengerCount) THEN TRY_CONVERT(INT, PassengerCount) END,&#xA;    TripDistanceMiles,&#xA;    CASE WHEN RateCodeID = FLOOR(RateCodeID) THEN TRY_CONVERT(INT, RateCodeID) END,&#xA;    CASE WHEN PaymentTypeID = FLOOR(PaymentTypeID) THEN TRY_CONVERT(INT, PaymentTypeID) END,&#xA;    StoreAndFwdFlag,&#xA;    FareAmount,&#xA;    ExtraAmount,&#xA;    MTATaxAmount,&#xA;    TipAmount,&#xA;    TollsAmount,&#xA;    ImprovementSurcharge,&#xA;    CongestionSurcharge,&#xA;    CBDCongestionFee,&#xA;    TotalAmount,&#xA;    CASE WHEN TripTypeID = FLOOR(TripTypeID) THEN TRY_CONVERT(INT, TripTypeID) END,&#xA;    EHailFeeAmount,&#xA;    DATEDIFF_BIG(SECOND, PickupDateTime, DropoffDateTime),&#xA;    0,&#xA;    0,&#xA;    ETLSourceKey,&#xA;    ETLFileHash,&#xA;    ETLLoadedAt&#xA;FROM S;&#xA;&#xA;    /* 6. Chi tinh do do/gan loi cho cac tep vua nap. */&#xA;UPDATE t&#xA;SET&#xA;    TripDistanceKm = TRY_CONVERT(DECIMAL(14,3), t.TripDistanceMiles * 1.609344),&#xA;    AverageSpeedKmh = CASE WHEN t.TripDurationSeconds &gt; 0 AND t.TripDistanceMiles &gt;= 0&#xA;        THEN TRY_CONVERT(DECIMAL(14,3), t.TripDistanceMiles * 1.609344 * 3600.0&#xA;            / NULLIF(t.TripDurationSeconds, 0)) END,&#xA;    RequestWaitSeconds = CASE WHEN t.RequestDateTime &lt;= t.PickupDateTime&#xA;        THEN DATEDIFF_BIG(SECOND, t.RequestDateTime, t.PickupDateTime) END,&#xA;    IsCoreValid = CASE&#xA;        WHEN t.PickupDateTime IS NULL OR t.DropoffDateTime IS NULL&#xA;          OR t.DropoffDateTime &lt;= t.PickupDateTime&#xA;          OR t.TripDurationSeconds &gt; CONVERT(BIGINT, @MaxDurationHours) * 3600&#xA;          OR (t.TaxiType &lt;&gt; 'FHV' AND (t.TripDistanceMiles IS NULL OR t.TripDistanceMiles &lt; 0))&#xA;        THEN 0 ELSE 1 END,&#xA;    QualityIssue = NULLIF(CONCAT(&#xA;        CASE WHEN t.PickupDateTime IS NULL THEN 'PICKUP_INVALID;' ELSE '' END,&#xA;        CASE WHEN t.DropoffDateTime IS NULL THEN 'DROPOFF_INVALID;' ELSE '' END,&#xA;        CASE WHEN t.DropoffDateTime &lt;= t.PickupDateTime THEN 'DURATION_NON_POSITIVE;' ELSE '' END,&#xA;        CASE WHEN t.TripDurationSeconds &gt; CONVERT(BIGINT, @MaxDurationHours) * 3600 THEN 'DURATION_OVER_LIMIT;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType &lt;&gt; 'FHV' AND t.TripDistanceMiles IS NULL THEN 'DISTANCE_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.TripDistanceMiles &lt; 0 THEN 'DISTANCE_NEGATIVE;' ELSE '' END,&#xA;        CASE WHEN t.TripDistanceMiles = 0 THEN 'DISTANCE_ZERO;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType IN ('YELLOW','GREEN') AND (t.PassengerCount IS NULL OR t.PassengerCount &lt;= 0) THEN 'PASSENGER_INVALID;' ELSE '' END,&#xA;        CASE WHEN pu.LocationID IS NULL THEN 'PU_LOCATION_UNKNOWN;' ELSE '' END,&#xA;        CASE WHEN dz.LocationID IS NULL THEN 'DO_LOCATION_UNKNOWN;' ELSE '' END,&#xA;        CASE WHEN t.TotalAmount &lt; 0 THEN 'TOTAL_NEGATIVE;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType &lt;&gt; 'FHV' AND t.TotalAmount IS NULL THEN 'TOTAL_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType = 'FHVHV' AND t.RequestDateTime IS NULL THEN 'REQUEST_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.RequestDateTime &gt; t.PickupDateTime THEN 'REQUEST_AFTER_PICKUP;' ELSE '' END,&#xA;        CASE WHEN t.OnSceneDateTime &gt; t.PickupDateTime THEN 'ONSCENE_AFTER_PICKUP;' ELSE '' END,&#xA;        CASE WHEN ABS(CONVERT(DECIMAL(38,0), t.SourceTripDurationSeconds) - t.TripDurationSeconds) &gt; 60&#xA;            THEN 'SOURCE_DURATION_MISMATCH;' ELSE '' END&#xA;    ), '')&#xA;FROM clean.Trip AS t&#xA;INNER JOIN #Todo AS scope ON scope.SourceKey=t.ETLSourceKey&#xA;LEFT JOIN clean.TaxiZone AS pu ON pu.LocationID = t.PULocationID&#xA;LEFT JOIN clean.TaxiZone AS dz ON dz.LocationID = t.DOLocationID&#xA;WHERE t.TaxiType=@TaxiType;&#xA;&#xA;    /* 7. Doi soat va ghi log trong CUNG transaction voi du lieu clean. */&#xA;    SELECT t.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS CleanRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=1 THEN 1 END) AS ValidRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=0 THEN 1 END) AS RejectedRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=1 AND t.QualityIssue IS NOT NULL THEN 1 END) AS WarningRows&#xA;    INTO #Result&#xA;    FROM clean.Trip AS t&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType&#xA;    GROUP BY t.ETLSourceKey;&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo AS f LEFT JOIN #Result AS r ON r.SourceKey=f.SourceKey&#xA;        WHERE COALESCE(r.CleanRows,0)&lt;&gt;f.ExpectedRows&#xA;            OR COALESCE(r.ValidRows,0)+COALESCE(r.RejectedRows,0)&lt;&gt;f.ExpectedRows)&#xA;        THROW 51224, 'So dong sau Transform khong khop. Rollback tep dang xu ly.', 1;&#xA;&#xA;    DELETE l FROM etl.TransformFileLog AS l&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=l.SourceKey&#xA;    WHERE l.DatasetCode=@Dataset;&#xA;&#xA;    INSERT etl.TransformFileLog&#xA;        (DatasetCode,SourceKey,FileHash,RuleVersion,ZoneHash,SourceRows,&#xA;         CleanRows,ValidRows,RejectedRows,WarningRows,CompletedAt)&#xA;    SELECT @Dataset,f.SourceKey,f.FileHash,@RuleVersion,@ZoneHash,f.ExpectedRows,&#xA;        COALESCE(r.CleanRows,0),COALESCE(r.ValidRows,0),COALESCE(r.RejectedRows,0),&#xA;        COALESCE(r.WarningRows,0),SYSDATETIME()&#xA;    FROM #Todo AS f LEFT JOIN #Result AS r ON r.SourceKey=f.SourceKey;&#xA;    END;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT&gt;0 ROLLBACK TRANSACTION;&#xA;    THROW;&#xA;END CATCH;&#xA;&#xA;SELECT @Dataset AS DatasetCode,&#xA;    (SELECT COUNT(*) FROM #Todo) AS ProcessedFiles,&#xA;    (SELECT COUNT(*) FROM #Files)-(SELECT COUNT(*) FROM #Todo) AS SkippedFiles;&#xA;&#xA;DROP TABLE IF EXISTS #Files;&#xA;DROP TABLE IF EXISTS #CleanCounts;&#xA;DROP TABLE IF EXISTS #Todo;&#xA;DROP TABLE IF EXISTS #StageCounts;&#xA;DROP TABLE IF EXISTS #Result;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_05_Transform_FHV"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{B2666594-C1F0-458B-A07E-62FA95E285B7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_05_Transform_FHV"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @Dataset VARCHAR(20)='fhv', @TaxiType VARCHAR(10)='FHV',&#xA;        @RuleVersion VARCHAR(64)='INCR_20261019_1|hours=48', @MaxDurationHours INT=48,&#xA;        @ZoneText NVARCHAR(MAX), @ZoneHash CHAR(64);&#xA;&#xA;DROP TABLE IF EXISTS #Files;&#xA;DROP TABLE IF EXISTS #CleanCounts;&#xA;DROP TABLE IF EXISTS #Todo;&#xA;DROP TABLE IF EXISTS #StageCounts;&#xA;DROP TABLE IF EXISTS #Result;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;    IF NOT EXISTS(SELECT 1 FROM clean.TaxiZone WITH(HOLDLOCK))&#xA;        THROW 51220, 'Chay task lookup truoc.', 1;&#xA;    IF EXISTS(SELECT 1 FROM clean.Trip WITH(UPDLOCK,HOLDLOCK)&#xA;        WHERE TaxiType=@TaxiType AND ETLSourceKey IS NULL)&#xA;        THROW 51221, 'Clean cu thieu ETLSourceKey; can chuan hoa lineage truoc.', 1;&#xA;    IF EXISTS(SELECT 1 FROM stg.FHVTrip WITH(HOLDLOCK) WHERE ETLSourceKey IS NULL)&#xA;        THROW 51222, 'Staging thieu lineage. Dung PKG_01 moi.', 1;&#xA;&#xA;SELECT @ZoneText=CONVERT(NVARCHAR(MAX),&#xA;    (SELECT LocationID,Borough,Zone,ServiceZone&#xA;     FROM clean.TaxiZone WITH(HOLDLOCK)&#xA;     ORDER BY LocationID FOR XML RAW('z'),TYPE));&#xA;SET @ZoneHash=CONVERT(CHAR(64),HASHBYTES('SHA2_256',@ZoneText),2);&#xA;&#xA;    /* 1. Cac tep Extract da nap thanh cong. Khong chuyen kieu du lieu o buoc nay. */&#xA;    SELECT SourceKey,FileHash,ExpectedRows&#xA;    INTO #Files&#xA;    FROM etl.ExtractFileLog WITH(UPDLOCK,HOLDLOCK)&#xA;    WHERE DatasetCode=@Dataset AND LoadStatus='SUCCEEDED' AND RowsLoaded=ExpectedRows;&#xA;&#xA;    /* 2. Kiem tra so dong/hash clean thuc te bang index theo tep. */&#xA;    SELECT t.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS CleanRows,&#xA;        COUNT_BIG(CASE WHEN t.ETLFileHash IS NULL OR t.ETLFileHash&lt;&gt;f.FileHash THEN 1 END) AS BadHashRows&#xA;    INTO #CleanCounts&#xA;    FROM clean.Trip AS t WITH(HOLDLOCK)&#xA;    INNER JOIN #Files AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType&#xA;    GROUP BY t.ETLSourceKey;&#xA;&#xA;    /* 3. Chi chon tep chua lam, tep thay doi, hoac clean bi thieu. */&#xA;SELECT f.SourceKey,f.FileHash,f.ExpectedRows&#xA;INTO #Todo&#xA;FROM #Files AS f&#xA;LEFT JOIN #CleanCounts AS c ON c.SourceKey=f.SourceKey&#xA;LEFT JOIN etl.TransformFileLog AS l WITH(UPDLOCK,HOLDLOCK)&#xA;    ON l.DatasetCode=@Dataset AND l.SourceKey=f.SourceKey&#xA;WHERE l.SourceKey IS NULL&#xA;    OR l.FileHash&lt;&gt;f.FileHash&#xA;    OR l.SourceRows&lt;&gt;f.ExpectedRows OR l.CleanRows&lt;&gt;f.ExpectedRows&#xA;    OR l.RuleVersion&lt;&gt;@RuleVersion OR l.ZoneHash&lt;&gt;@ZoneHash&#xA;    OR COALESCE(c.CleanRows,0)&lt;&gt;f.ExpectedRows&#xA;    OR COALESCE(c.BadHashRows,0)&gt;0;&#xA;    CREATE UNIQUE CLUSTERED INDEX IX_Todo_Source ON #Todo(SourceKey);&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo)&#xA;    BEGIN&#xA;    /* 4. Kiem tra staging cua DUNG cac tep can xu ly truoc khi sua clean. */&#xA;    SELECT s.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS SourceRows,&#xA;        COUNT_BIG(CASE WHEN s.ETLFileHash IS NULL OR s.ETLFileHash&lt;&gt;f.FileHash THEN 1 END) AS BadHashRows&#xA;    INTO #StageCounts&#xA;    FROM stg.FHVTrip AS s WITH(HOLDLOCK)&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=s.ETLSourceKey&#xA;    GROUP BY s.ETLSourceKey;&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo AS f LEFT JOIN #StageCounts AS s ON s.SourceKey=f.SourceKey&#xA;        WHERE COALESCE(s.SourceRows,0)&lt;&gt;f.ExpectedRows OR COALESCE(s.BadHashRows,0)&gt;0)&#xA;        THROW 51223, 'Staging cua tep can Transform khong khop log. Chay lai PKG_01.', 1;&#xA;&#xA;    /* 5. Giu nguyen cac tep da hoan tat; chi thay the cac tep trong #Todo. */&#xA;    DELETE t FROM clean.Trip AS t&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType;&#xA;&#xA;;WITH S AS&#xA;(&#xA;    SELECT&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([pickup_datetime])), '')) AS PickupDateTime,&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([dropOff_datetime])), '')) AS DropoffDateTime,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([PULocationID])), '')) AS PULocationID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([DOLocationID])), '')) AS DOLocationID,&#xA;        UPPER(NULLIF(LTRIM(RTRIM([dispatching_base_num])), '')) AS DispatchingBaseNum,&#xA;        UPPER(NULLIF(LTRIM(RTRIM([Affiliated_base_number])), '')) AS AffiliatedBaseNum,&#xA;        CASE WHEN NULLIF(LTRIM(RTRIM([SR_Flag])), '') IN ('1','1.0') THEN '1' WHEN NULLIF(LTRIM(RTRIM([SR_Flag])), '') IN ('0','0.0') THEN '0' END AS SourceSRFlag,&#xA;        ETLSourceKey,&#xA;        ETLFileHash,&#xA;        ETLLoadedAt&#xA;    FROM stg.FHVTrip AS s WITH(HOLDLOCK)&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=s.ETLSourceKey&#xA;)&#xA;INSERT INTO clean.Trip&#xA;(&#xA;    TaxiType, PickupDateTime, DropoffDateTime, PULocationID, DOLocationID, DispatchingBaseNum, AffiliatedBaseNum, SourceSRFlag, TripDurationSeconds, IsTotalCalculated, IsCoreValid, ETLSourceKey, ETLFileHash, ETLLoadedAt&#xA;)&#xA;SELECT&#xA;    'FHV',&#xA;    PickupDateTime,&#xA;    DropoffDateTime,&#xA;    CASE WHEN PULocationID = FLOOR(PULocationID) THEN TRY_CONVERT(INT, PULocationID) END,&#xA;    CASE WHEN DOLocationID = FLOOR(DOLocationID) THEN TRY_CONVERT(INT, DOLocationID) END,&#xA;    DispatchingBaseNum,&#xA;    AffiliatedBaseNum,&#xA;    SourceSRFlag,&#xA;    DATEDIFF_BIG(SECOND, PickupDateTime, DropoffDateTime),&#xA;    0,&#xA;    0,&#xA;    ETLSourceKey,&#xA;    ETLFileHash,&#xA;    ETLLoadedAt&#xA;FROM S;&#xA;&#xA;    /* 6. Chi tinh do do/gan loi cho cac tep vua nap. */&#xA;UPDATE t&#xA;SET&#xA;    TripDistanceKm = TRY_CONVERT(DECIMAL(14,3), t.TripDistanceMiles * 1.609344),&#xA;    AverageSpeedKmh = CASE WHEN t.TripDurationSeconds &gt; 0 AND t.TripDistanceMiles &gt;= 0&#xA;        THEN TRY_CONVERT(DECIMAL(14,3), t.TripDistanceMiles * 1.609344 * 3600.0&#xA;            / NULLIF(t.TripDurationSeconds, 0)) END,&#xA;    RequestWaitSeconds = CASE WHEN t.RequestDateTime &lt;= t.PickupDateTime&#xA;        THEN DATEDIFF_BIG(SECOND, t.RequestDateTime, t.PickupDateTime) END,&#xA;    IsCoreValid = CASE&#xA;        WHEN t.PickupDateTime IS NULL OR t.DropoffDateTime IS NULL&#xA;          OR t.DropoffDateTime &lt;= t.PickupDateTime&#xA;          OR t.TripDurationSeconds &gt; CONVERT(BIGINT, @MaxDurationHours) * 3600&#xA;          OR (t.TaxiType &lt;&gt; 'FHV' AND (t.TripDistanceMiles IS NULL OR t.TripDistanceMiles &lt; 0))&#xA;        THEN 0 ELSE 1 END,&#xA;    QualityIssue = NULLIF(CONCAT(&#xA;        CASE WHEN t.PickupDateTime IS NULL THEN 'PICKUP_INVALID;' ELSE '' END,&#xA;        CASE WHEN t.DropoffDateTime IS NULL THEN 'DROPOFF_INVALID;' ELSE '' END,&#xA;        CASE WHEN t.DropoffDateTime &lt;= t.PickupDateTime THEN 'DURATION_NON_POSITIVE;' ELSE '' END,&#xA;        CASE WHEN t.TripDurationSeconds &gt; CONVERT(BIGINT, @MaxDurationHours) * 3600 THEN 'DURATION_OVER_LIMIT;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType &lt;&gt; 'FHV' AND t.TripDistanceMiles IS NULL THEN 'DISTANCE_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.TripDistanceMiles &lt; 0 THEN 'DISTANCE_NEGATIVE;' ELSE '' END,&#xA;        CASE WHEN t.TripDistanceMiles = 0 THEN 'DISTANCE_ZERO;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType IN ('YELLOW','GREEN') AND (t.PassengerCount IS NULL OR t.PassengerCount &lt;= 0) THEN 'PASSENGER_INVALID;' ELSE '' END,&#xA;        CASE WHEN pu.LocationID IS NULL THEN 'PU_LOCATION_UNKNOWN;' ELSE '' END,&#xA;        CASE WHEN dz.LocationID IS NULL THEN 'DO_LOCATION_UNKNOWN;' ELSE '' END,&#xA;        CASE WHEN t.TotalAmount &lt; 0 THEN 'TOTAL_NEGATIVE;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType &lt;&gt; 'FHV' AND t.TotalAmount IS NULL THEN 'TOTAL_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType = 'FHVHV' AND t.RequestDateTime IS NULL THEN 'REQUEST_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.RequestDateTime &gt; t.PickupDateTime THEN 'REQUEST_AFTER_PICKUP;' ELSE '' END,&#xA;        CASE WHEN t.OnSceneDateTime &gt; t.PickupDateTime THEN 'ONSCENE_AFTER_PICKUP;' ELSE '' END,&#xA;        CASE WHEN ABS(CONVERT(DECIMAL(38,0), t.SourceTripDurationSeconds) - t.TripDurationSeconds) &gt; 60&#xA;            THEN 'SOURCE_DURATION_MISMATCH;' ELSE '' END&#xA;    ), '')&#xA;FROM clean.Trip AS t&#xA;INNER JOIN #Todo AS scope ON scope.SourceKey=t.ETLSourceKey&#xA;LEFT JOIN clean.TaxiZone AS pu ON pu.LocationID = t.PULocationID&#xA;LEFT JOIN clean.TaxiZone AS dz ON dz.LocationID = t.DOLocationID&#xA;WHERE t.TaxiType=@TaxiType;&#xA;&#xA;    /* 7. Doi soat va ghi log trong CUNG transaction voi du lieu clean. */&#xA;    SELECT t.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS CleanRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=1 THEN 1 END) AS ValidRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=0 THEN 1 END) AS RejectedRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=1 AND t.QualityIssue IS NOT NULL THEN 1 END) AS WarningRows&#xA;    INTO #Result&#xA;    FROM clean.Trip AS t&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType&#xA;    GROUP BY t.ETLSourceKey;&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo AS f LEFT JOIN #Result AS r ON r.SourceKey=f.SourceKey&#xA;        WHERE COALESCE(r.CleanRows,0)&lt;&gt;f.ExpectedRows&#xA;            OR COALESCE(r.ValidRows,0)+COALESCE(r.RejectedRows,0)&lt;&gt;f.ExpectedRows)&#xA;        THROW 51224, 'So dong sau Transform khong khop. Rollback tep dang xu ly.', 1;&#xA;&#xA;    DELETE l FROM etl.TransformFileLog AS l&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=l.SourceKey&#xA;    WHERE l.DatasetCode=@Dataset;&#xA;&#xA;    INSERT etl.TransformFileLog&#xA;        (DatasetCode,SourceKey,FileHash,RuleVersion,ZoneHash,SourceRows,&#xA;         CleanRows,ValidRows,RejectedRows,WarningRows,CompletedAt)&#xA;    SELECT @Dataset,f.SourceKey,f.FileHash,@RuleVersion,@ZoneHash,f.ExpectedRows,&#xA;        COALESCE(r.CleanRows,0),COALESCE(r.ValidRows,0),COALESCE(r.RejectedRows,0),&#xA;        COALESCE(r.WarningRows,0),SYSDATETIME()&#xA;    FROM #Todo AS f LEFT JOIN #Result AS r ON r.SourceKey=f.SourceKey;&#xA;    END;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT&gt;0 ROLLBACK TRANSACTION;&#xA;    THROW;&#xA;END CATCH;&#xA;&#xA;SELECT @Dataset AS DatasetCode,&#xA;    (SELECT COUNT(*) FROM #Todo) AS ProcessedFiles,&#xA;    (SELECT COUNT(*) FROM #Files)-(SELECT COUNT(*) FROM #Todo) AS SkippedFiles;&#xA;&#xA;DROP TABLE IF EXISTS #Files;&#xA;DROP TABLE IF EXISTS #CleanCounts;&#xA;DROP TABLE IF EXISTS #Todo;&#xA;DROP TABLE IF EXISTS #StageCounts;&#xA;DROP TABLE IF EXISTS #Result;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_06_Transform_FHVHV"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{DE1866DB-AC1C-4A14-99C0-50794101577A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_06_Transform_FHVHV"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @Dataset VARCHAR(20)='fhvhv', @TaxiType VARCHAR(10)='FHVHV',&#xA;        @RuleVersion VARCHAR(64)='INCR_20261019_1|hours=48', @MaxDurationHours INT=48,&#xA;        @ZoneText NVARCHAR(MAX), @ZoneHash CHAR(64);&#xA;&#xA;DROP TABLE IF EXISTS #Files;&#xA;DROP TABLE IF EXISTS #CleanCounts;&#xA;DROP TABLE IF EXISTS #Todo;&#xA;DROP TABLE IF EXISTS #StageCounts;&#xA;DROP TABLE IF EXISTS #Result;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;    IF NOT EXISTS(SELECT 1 FROM clean.TaxiZone WITH(HOLDLOCK))&#xA;        THROW 51220, 'Chay task lookup truoc.', 1;&#xA;    IF EXISTS(SELECT 1 FROM clean.Trip WITH(UPDLOCK,HOLDLOCK)&#xA;        WHERE TaxiType=@TaxiType AND ETLSourceKey IS NULL)&#xA;        THROW 51221, 'Clean cu thieu ETLSourceKey; can chuan hoa lineage truoc.', 1;&#xA;    IF EXISTS(SELECT 1 FROM stg.FHVHVTrip WITH(HOLDLOCK) WHERE ETLSourceKey IS NULL)&#xA;        THROW 51222, 'Staging thieu lineage. Dung PKG_01 moi.', 1;&#xA;&#xA;SELECT @ZoneText=CONVERT(NVARCHAR(MAX),&#xA;    (SELECT LocationID,Borough,Zone,ServiceZone&#xA;     FROM clean.TaxiZone WITH(HOLDLOCK)&#xA;     ORDER BY LocationID FOR XML RAW('z'),TYPE));&#xA;SET @ZoneHash=CONVERT(CHAR(64),HASHBYTES('SHA2_256',@ZoneText),2);&#xA;&#xA;    /* 1. Cac tep Extract da nap thanh cong. Khong chuyen kieu du lieu o buoc nay. */&#xA;    SELECT SourceKey,FileHash,ExpectedRows&#xA;    INTO #Files&#xA;    FROM etl.ExtractFileLog WITH(UPDLOCK,HOLDLOCK)&#xA;    WHERE DatasetCode=@Dataset AND LoadStatus='SUCCEEDED' AND RowsLoaded=ExpectedRows;&#xA;&#xA;    /* 2. Kiem tra so dong/hash clean thuc te bang index theo tep. */&#xA;    SELECT t.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS CleanRows,&#xA;        COUNT_BIG(CASE WHEN t.ETLFileHash IS NULL OR t.ETLFileHash&lt;&gt;f.FileHash THEN 1 END) AS BadHashRows&#xA;    INTO #CleanCounts&#xA;    FROM clean.Trip AS t WITH(HOLDLOCK)&#xA;    INNER JOIN #Files AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType&#xA;    GROUP BY t.ETLSourceKey;&#xA;&#xA;    /* 3. Chi chon tep chua lam, tep thay doi, hoac clean bi thieu. */&#xA;SELECT f.SourceKey,f.FileHash,f.ExpectedRows&#xA;INTO #Todo&#xA;FROM #Files AS f&#xA;LEFT JOIN #CleanCounts AS c ON c.SourceKey=f.SourceKey&#xA;LEFT JOIN etl.TransformFileLog AS l WITH(UPDLOCK,HOLDLOCK)&#xA;    ON l.DatasetCode=@Dataset AND l.SourceKey=f.SourceKey&#xA;WHERE l.SourceKey IS NULL&#xA;    OR l.FileHash&lt;&gt;f.FileHash&#xA;    OR l.SourceRows&lt;&gt;f.ExpectedRows OR l.CleanRows&lt;&gt;f.ExpectedRows&#xA;    OR l.RuleVersion&lt;&gt;@RuleVersion OR l.ZoneHash&lt;&gt;@ZoneHash&#xA;    OR COALESCE(c.CleanRows,0)&lt;&gt;f.ExpectedRows&#xA;    OR COALESCE(c.BadHashRows,0)&gt;0;&#xA;    CREATE UNIQUE CLUSTERED INDEX IX_Todo_Source ON #Todo(SourceKey);&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo)&#xA;    BEGIN&#xA;    /* 4. Kiem tra staging cua DUNG cac tep can xu ly truoc khi sua clean. */&#xA;    SELECT s.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS SourceRows,&#xA;        COUNT_BIG(CASE WHEN s.ETLFileHash IS NULL OR s.ETLFileHash&lt;&gt;f.FileHash THEN 1 END) AS BadHashRows&#xA;    INTO #StageCounts&#xA;    FROM stg.FHVHVTrip AS s WITH(HOLDLOCK)&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=s.ETLSourceKey&#xA;    GROUP BY s.ETLSourceKey;&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo AS f LEFT JOIN #StageCounts AS s ON s.SourceKey=f.SourceKey&#xA;        WHERE COALESCE(s.SourceRows,0)&lt;&gt;f.ExpectedRows OR COALESCE(s.BadHashRows,0)&gt;0)&#xA;        THROW 51223, 'Staging cua tep can Transform khong khop log. Chay lai PKG_01.', 1;&#xA;&#xA;    /* 5. Giu nguyen cac tep da hoan tat; chi thay the cac tep trong #Todo. */&#xA;    DELETE t FROM clean.Trip AS t&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType;&#xA;&#xA;;WITH S AS&#xA;(&#xA;    SELECT&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([pickup_datetime])), '')) AS PickupDateTime,&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([dropoff_datetime])), '')) AS DropoffDateTime,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([PULocationID])), '')) AS PULocationID,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([DOLocationID])), '')) AS DOLocationID,&#xA;        UPPER(NULLIF(LTRIM(RTRIM([hvfhs_license_num])), '')) AS HVFHSLicenseNum,&#xA;        UPPER(NULLIF(LTRIM(RTRIM([dispatching_base_num])), '')) AS DispatchingBaseNum,&#xA;        UPPER(NULLIF(LTRIM(RTRIM([originating_base_num])), '')) AS OriginatingBaseNum,&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([request_datetime])), '')) AS RequestDateTime,&#xA;        TRY_CONVERT(DATETIME2(0), NULLIF(LTRIM(RTRIM([on_scene_datetime])), '')) AS OnSceneDateTime,&#xA;        TRY_CONVERT(DECIMAL(12,3), NULLIF(LTRIM(RTRIM([trip_miles])), '')) AS TripDistanceMiles,&#xA;        TRY_CONVERT(DECIMAL(38,18), NULLIF(LTRIM(RTRIM([trip_time])), '')) AS SourceTripDurationSeconds,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([base_passenger_fare])), '')) AS FareAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([tolls])), '')) AS TollsAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([bcf])), '')) AS BCFAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([sales_tax])), '')) AS SalesTaxAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([congestion_surcharge])), '')) AS CongestionSurcharge,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([airport_fee])), '')) AS AirportFee,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([tips])), '')) AS TipAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([driver_pay])), '')) AS DriverPayAmount,&#xA;        TRY_CONVERT(DECIMAL(18,2), NULLIF(LTRIM(RTRIM([cbd_congestion_fee])), '')) AS CBDCongestionFee,&#xA;        CASE WHEN UPPER(NULLIF(LTRIM(RTRIM([shared_request_flag])), '')) IN ('Y','1','TRUE') THEN 'Y' WHEN UPPER(NULLIF(LTRIM(RTRIM([shared_request_flag])), '')) IN ('N','0','FALSE') THEN 'N' END AS SharedRequestFlag,&#xA;        CASE WHEN UPPER(NULLIF(LTRIM(RTRIM([shared_match_flag])), '')) IN ('Y','1','TRUE') THEN 'Y' WHEN UPPER(NULLIF(LTRIM(RTRIM([shared_match_flag])), '')) IN ('N','0','FALSE') THEN 'N' END AS SharedMatchFlag,&#xA;        CASE WHEN UPPER(NULLIF(LTRIM(RTRIM([access_a_ride_flag])), '')) IN ('Y','1','TRUE') THEN 'Y' WHEN UPPER(NULLIF(LTRIM(RTRIM([access_a_ride_flag])), '')) IN ('N','0','FALSE') THEN 'N' END AS AccessARideFlag,&#xA;        CASE WHEN UPPER(NULLIF(LTRIM(RTRIM([wav_request_flag])), '')) IN ('Y','1','TRUE') THEN 'Y' WHEN UPPER(NULLIF(LTRIM(RTRIM([wav_request_flag])), '')) IN ('N','0','FALSE') THEN 'N' END AS WAVRequestFlag,&#xA;        CASE WHEN UPPER(NULLIF(LTRIM(RTRIM([wav_match_flag])), '')) IN ('Y','1','TRUE') THEN 'Y' WHEN UPPER(NULLIF(LTRIM(RTRIM([wav_match_flag])), '')) IN ('N','0','FALSE') THEN 'N' END AS WAVMatchFlag,&#xA;        ETLSourceKey,&#xA;        ETLFileHash,&#xA;        ETLLoadedAt,&#xA;        TRY_CONVERT(DATE, SUBSTRING(ETLSourceKey, 16, 7) + '-01', 23) AS SourceMonth&#xA;    FROM stg.FHVHVTrip AS s WITH(HOLDLOCK)&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=s.ETLSourceKey&#xA;)&#xA;INSERT INTO clean.Trip&#xA;(&#xA;    TaxiType, PickupDateTime, DropoffDateTime, PULocationID, DOLocationID, HVFHSLicenseNum, DispatchingBaseNum, OriginatingBaseNum, RequestDateTime, OnSceneDateTime, TripDistanceMiles, SourceTripDurationSeconds, FareAmount, TollsAmount, BCFAmount, SalesTaxAmount, CongestionSurcharge, AirportFee, TipAmount, DriverPayAmount, CBDCongestionFee, SharedRequestFlag, SharedMatchFlag, AccessARideFlag, WAVRequestFlag, WAVMatchFlag, TripDurationSeconds, IsTotalCalculated, IsCoreValid, ETLSourceKey, ETLFileHash, ETLLoadedAt, TotalAmount&#xA;)&#xA;SELECT&#xA;    'FHVHV',&#xA;    PickupDateTime,&#xA;    DropoffDateTime,&#xA;    CASE WHEN PULocationID = FLOOR(PULocationID) THEN TRY_CONVERT(INT, PULocationID) END,&#xA;    CASE WHEN DOLocationID = FLOOR(DOLocationID) THEN TRY_CONVERT(INT, DOLocationID) END,&#xA;    HVFHSLicenseNum,&#xA;    DispatchingBaseNum,&#xA;    OriginatingBaseNum,&#xA;    RequestDateTime,&#xA;    OnSceneDateTime,&#xA;    TripDistanceMiles,&#xA;    CASE WHEN SourceTripDurationSeconds = FLOOR(SourceTripDurationSeconds) THEN TRY_CONVERT(BIGINT, SourceTripDurationSeconds) END,&#xA;    FareAmount,&#xA;    TollsAmount,&#xA;    BCFAmount,&#xA;    SalesTaxAmount,&#xA;    CongestionSurcharge,&#xA;    AirportFee,&#xA;    TipAmount,&#xA;    DriverPayAmount,&#xA;    CBDCongestionFee,&#xA;    SharedRequestFlag,&#xA;    SharedMatchFlag,&#xA;    AccessARideFlag,&#xA;    WAVRequestFlag,&#xA;    WAVMatchFlag,&#xA;    DATEDIFF_BIG(SECOND, PickupDateTime, DropoffDateTime),&#xA;    1,&#xA;    0,&#xA;    ETLSourceKey,&#xA;    ETLFileHash,&#xA;    ETLLoadedAt,&#xA;    CASE WHEN FareAmount IS NOT NULL AND TollsAmount IS NOT NULL&#xA;            AND BCFAmount IS NOT NULL AND SalesTaxAmount IS NOT NULL&#xA;            AND CongestionSurcharge IS NOT NULL AND AirportFee IS NOT NULL AND TipAmount IS NOT NULL&#xA;            AND (CBDCongestionFee IS NOT NULL OR SourceMonth &lt; '20250101')&#xA;        THEN TRY_CONVERT(DECIMAL(18,2), FareAmount + TollsAmount + BCFAmount + SalesTaxAmount&#xA;            + CongestionSurcharge + AirportFee + TipAmount + COALESCE(CBDCongestionFee, 0)) END&#xA;FROM S;&#xA;&#xA;    /* 6. Chi tinh do do/gan loi cho cac tep vua nap. */&#xA;UPDATE t&#xA;SET&#xA;    TripDistanceKm = TRY_CONVERT(DECIMAL(14,3), t.TripDistanceMiles * 1.609344),&#xA;    AverageSpeedKmh = CASE WHEN t.TripDurationSeconds &gt; 0 AND t.TripDistanceMiles &gt;= 0&#xA;        THEN TRY_CONVERT(DECIMAL(14,3), t.TripDistanceMiles * 1.609344 * 3600.0&#xA;            / NULLIF(t.TripDurationSeconds, 0)) END,&#xA;    RequestWaitSeconds = CASE WHEN t.RequestDateTime &lt;= t.PickupDateTime&#xA;        THEN DATEDIFF_BIG(SECOND, t.RequestDateTime, t.PickupDateTime) END,&#xA;    IsCoreValid = CASE&#xA;        WHEN t.PickupDateTime IS NULL OR t.DropoffDateTime IS NULL&#xA;          OR t.DropoffDateTime &lt;= t.PickupDateTime&#xA;          OR t.TripDurationSeconds &gt; CONVERT(BIGINT, @MaxDurationHours) * 3600&#xA;          OR (t.TaxiType &lt;&gt; 'FHV' AND (t.TripDistanceMiles IS NULL OR t.TripDistanceMiles &lt; 0))&#xA;        THEN 0 ELSE 1 END,&#xA;    QualityIssue = NULLIF(CONCAT(&#xA;        CASE WHEN t.PickupDateTime IS NULL THEN 'PICKUP_INVALID;' ELSE '' END,&#xA;        CASE WHEN t.DropoffDateTime IS NULL THEN 'DROPOFF_INVALID;' ELSE '' END,&#xA;        CASE WHEN t.DropoffDateTime &lt;= t.PickupDateTime THEN 'DURATION_NON_POSITIVE;' ELSE '' END,&#xA;        CASE WHEN t.TripDurationSeconds &gt; CONVERT(BIGINT, @MaxDurationHours) * 3600 THEN 'DURATION_OVER_LIMIT;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType &lt;&gt; 'FHV' AND t.TripDistanceMiles IS NULL THEN 'DISTANCE_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.TripDistanceMiles &lt; 0 THEN 'DISTANCE_NEGATIVE;' ELSE '' END,&#xA;        CASE WHEN t.TripDistanceMiles = 0 THEN 'DISTANCE_ZERO;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType IN ('YELLOW','GREEN') AND (t.PassengerCount IS NULL OR t.PassengerCount &lt;= 0) THEN 'PASSENGER_INVALID;' ELSE '' END,&#xA;        CASE WHEN pu.LocationID IS NULL THEN 'PU_LOCATION_UNKNOWN;' ELSE '' END,&#xA;        CASE WHEN dz.LocationID IS NULL THEN 'DO_LOCATION_UNKNOWN;' ELSE '' END,&#xA;        CASE WHEN t.TotalAmount &lt; 0 THEN 'TOTAL_NEGATIVE;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType &lt;&gt; 'FHV' AND t.TotalAmount IS NULL THEN 'TOTAL_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.TaxiType = 'FHVHV' AND t.RequestDateTime IS NULL THEN 'REQUEST_MISSING;' ELSE '' END,&#xA;        CASE WHEN t.RequestDateTime &gt; t.PickupDateTime THEN 'REQUEST_AFTER_PICKUP;' ELSE '' END,&#xA;        CASE WHEN t.OnSceneDateTime &gt; t.PickupDateTime THEN 'ONSCENE_AFTER_PICKUP;' ELSE '' END,&#xA;        CASE WHEN ABS(CONVERT(DECIMAL(38,0), t.SourceTripDurationSeconds) - t.TripDurationSeconds) &gt; 60&#xA;            THEN 'SOURCE_DURATION_MISMATCH;' ELSE '' END&#xA;    ), '')&#xA;FROM clean.Trip AS t&#xA;INNER JOIN #Todo AS scope ON scope.SourceKey=t.ETLSourceKey&#xA;LEFT JOIN clean.TaxiZone AS pu ON pu.LocationID = t.PULocationID&#xA;LEFT JOIN clean.TaxiZone AS dz ON dz.LocationID = t.DOLocationID&#xA;WHERE t.TaxiType=@TaxiType;&#xA;&#xA;    /* 7. Doi soat va ghi log trong CUNG transaction voi du lieu clean. */&#xA;    SELECT t.ETLSourceKey AS SourceKey,COUNT_BIG(*) AS CleanRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=1 THEN 1 END) AS ValidRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=0 THEN 1 END) AS RejectedRows,&#xA;        COUNT_BIG(CASE WHEN t.IsCoreValid=1 AND t.QualityIssue IS NOT NULL THEN 1 END) AS WarningRows&#xA;    INTO #Result&#xA;    FROM clean.Trip AS t&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=t.ETLSourceKey&#xA;    WHERE t.TaxiType=@TaxiType&#xA;    GROUP BY t.ETLSourceKey;&#xA;&#xA;    IF EXISTS(SELECT 1 FROM #Todo AS f LEFT JOIN #Result AS r ON r.SourceKey=f.SourceKey&#xA;        WHERE COALESCE(r.CleanRows,0)&lt;&gt;f.ExpectedRows&#xA;            OR COALESCE(r.ValidRows,0)+COALESCE(r.RejectedRows,0)&lt;&gt;f.ExpectedRows)&#xA;        THROW 51224, 'So dong sau Transform khong khop. Rollback tep dang xu ly.', 1;&#xA;&#xA;    DELETE l FROM etl.TransformFileLog AS l&#xA;    INNER JOIN #Todo AS f ON f.SourceKey=l.SourceKey&#xA;    WHERE l.DatasetCode=@Dataset;&#xA;&#xA;    INSERT etl.TransformFileLog&#xA;        (DatasetCode,SourceKey,FileHash,RuleVersion,ZoneHash,SourceRows,&#xA;         CleanRows,ValidRows,RejectedRows,WarningRows,CompletedAt)&#xA;    SELECT @Dataset,f.SourceKey,f.FileHash,@RuleVersion,@ZoneHash,f.ExpectedRows,&#xA;        COALESCE(r.CleanRows,0),COALESCE(r.ValidRows,0),COALESCE(r.RejectedRows,0),&#xA;        COALESCE(r.WarningRows,0),SYSDATETIME()&#xA;    FROM #Todo AS f LEFT JOIN #Result AS r ON r.SourceKey=f.SourceKey;&#xA;    END;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT&gt;0 ROLLBACK TRANSACTION;&#xA;    THROW;&#xA;END CATCH;&#xA;&#xA;SELECT @Dataset AS DatasetCode,&#xA;    (SELECT COUNT(*) FROM #Todo) AS ProcessedFiles,&#xA;    (SELECT COUNT(*) FROM #Files)-(SELECT COUNT(*) FROM #Todo) AS SkippedFiles;&#xA;&#xA;DROP TABLE IF EXISTS #Files;&#xA;DROP TABLE IF EXISTS #CleanCounts;&#xA;DROP TABLE IF EXISTS #Todo;&#xA;DROP TABLE IF EXISTS #StageCounts;&#xA;DROP TABLE IF EXISTS #Result;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EST_07_Validate_Transform"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{E3D3B375-D5CC-4E36-B826-D4F07AF3E620}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="EST_07_Validate_Transform"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{428D3CB7-3BB4-4D96-8F32-4EE97109955B}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;DECLARE @ZoneText NVARCHAR(MAX),@ZoneHash CHAR(64);&#xA;SELECT @ZoneText=CONVERT(NVARCHAR(MAX),&#xA;    (SELECT LocationID,Borough,Zone,ServiceZone&#xA;     FROM clean.TaxiZone WITH(HOLDLOCK)&#xA;     ORDER BY LocationID FOR XML RAW('z'),TYPE));&#xA;SET @ZoneHash=CONVERT(CHAR(64),HASHBYTES('SHA2_256',@ZoneText),2);&#xA;&#xA;/* Doc log nho de kiem tra coverage; khong UPDATE lai toan bo clean. */&#xA;IF NOT EXISTS(SELECT 1 FROM etl.ExtractFileLog&#xA;    WHERE DatasetCode IN ('yellow','green','fhv','fhvhv') AND LoadStatus='SUCCEEDED')&#xA;    THROW 51230, 'Chua co tep chuyen di Extract thanh cong.', 1;&#xA;&#xA;IF EXISTS(SELECT 1 FROM etl.ExtractFileLog AS e&#xA;    LEFT JOIN etl.TransformFileLog AS t ON t.DatasetCode=e.DatasetCode AND t.SourceKey=e.SourceKey&#xA;    WHERE e.DatasetCode IN ('yellow','green','fhv','fhvhv') AND e.LoadStatus='SUCCEEDED'&#xA;        AND (t.SourceKey IS NULL OR t.FileHash&lt;&gt;e.FileHash&#xA;            OR t.SourceRows&lt;&gt;e.ExpectedRows OR t.CleanRows&lt;&gt;e.ExpectedRows&#xA;            OR t.RuleVersion&lt;&gt;'INCR_20261019_1|hours=48' OR t.ZoneHash&lt;&gt;@ZoneHash&#xA;            OR t.CleanRows&lt;&gt;t.ValidRows+t.RejectedRows))&#xA;    THROW 51231, 'Con tep chua Transform dung phien ban hien tai. Kiem tra log.', 1;&#xA;&#xA;SELECT t.DatasetCode,COUNT_BIG(*) AS CompletedFiles,&#xA;    SUM(t.SourceRows) AS SourceRows,SUM(t.CleanRows) AS CleanRows,&#xA;    SUM(t.ValidRows) AS ValidRows,SUM(t.RejectedRows) AS RejectedRows,&#xA;    SUM(t.WarningRows) AS WarningRows&#xA;FROM etl.TransformFileLog AS t&#xA;INNER JOIN etl.ExtractFileLog AS e ON e.DatasetCode=t.DatasetCode AND e.SourceKey=t.SourceKey&#xA;WHERE e.LoadStatus='SUCCEEDED' AND t.FileHash=e.FileHash&#xA;GROUP BY t.DatasetCode ORDER BY t.DatasetCode;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
